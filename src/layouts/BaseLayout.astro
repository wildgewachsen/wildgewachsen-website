---
// Basis-Layout: Head-Skelett + Header/Footer.
// SEO-Werte (canonical, hreflang, Schema) kommen NICHT von hier, sondern
// werden ab Phase 3/4 pro Seite aus migration/site_snapshot.json gesetzt.
import '@fontsource/young-serif';
import '@fontsource-variable/alegreya';
import '@fontsource/courier-prime';
import '@fontsource-variable/caveat';
import '../styles/tokens.css';
import '../styles/base.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  lang?: 'de' | 'en';
}

const { title, description, lang = 'de' } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      // Hell ist Standard; Dunkel nur wenn der Nutzer es per Toggle gewaehlt hat.
      // Laeuft vor dem ersten Paint, damit nichts flackert.
      if (localStorage.getItem('wg-theme') === 'dark')
        document.documentElement.dataset.theme = 'dark';
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}
    </a>
    <SiteHeader lang={lang} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <script is:inline>
      // Newsletter (Brevo, seit 17.08.2026; vorher Kit). EIN Handler fuer alle
      // form[data-newsletter] auf der Seite; Texte + Verhalten unveraendert.
      //
      // Die Sprachtrennung entsteht ueber ZWEI Brevo-Formulare, nicht ueber ein
      // Tag im Request: die Seitensprache waehlt den Endpunkt, und wer sich wo
      // eingetragen hat, steht damit in Brevo fest (je eigene Liste, je eigene
      // Bestaetigungs-Weiterleitung). Kein API-Schluessel im Browser, kein
      // Server noetig -- der Endpunkt schickt
      // access-control-allow-origin: https://wildgewachsen-australien.de
      // (am 15.08.2026 per OPTIONS und POST gemessen).
      //
      // Warum Brevo statt Kit: Kits Editor nimmt kein HTML, die Mails liessen
      // sich dort nicht im Marken-Look bauen. Belege + Auswahlverfahren in
      // Projekt_Wildgewachsen/recherche/newsletter-tool-alternative-kit-2026-08-14.md
      (function () {
        // >>> Die einzigen zwei Werte, die beim Anlegen der Brevo-Formulare
        // >>> eingetragen werden: die action-Adressen aus dem Reiter
        // >>> "Einfaches HTML" (Schritt 6 "Teilen") des jeweiligen Formulars.
        var BREVO_FORM = {
          de: 'https://4e8fdf9a.sibforms.com/serve/MUIFABaywhK4Z1Iq1v6XA16Z3v7_NWbsEpHZ3odAsDkxSS3C2_Xkd3XKgigveFVHAmuoecsbCHJ0l9BVNe4ca3F1V4YnkO05545o0GWxhD4rFJe-sx9Ct8eRYpK5yOj9GY-WZDxlhxJrTSwFIJHK17O76yKkh4752Gy-rJK2uTJPd-wp1T2QV-ZFnj4QGRU30HwSWSUBoc2xkXrMSA==',
          en: 'https://4e8fdf9a.sibforms.com/serve/MUIFADll01Ztzz5DTK-muRyLOdV6rc0lukwQiw8WPctRSpTtOCs1OqxpSHSOZjfMUu-cbEhDMnHONHhPDwU0yhykPUNKojDGMSqGcsJrDD1m2tm5MWPtmX8fH93baq-ClTB9tjwiysEEbcB5pgg2CHy4fO93pIyosGYFGVJpHS1-xywsxD6O8TuSDrpNR-GTW4kdexTRQzDDzNyikw==',
        };

        var messages = {
          de: {
            success: 'Danke! Bitte bestätige deine E-Mail.',
            error: 'Etwas ist schiefgelaufen. Bitte versuche es erneut.',
            network: 'Verbindungsfehler. Bitte versuche es erneut.',
          },
          en: {
            success: 'Thanks! Please confirm your email.',
            error: 'Something went wrong. Please try again.',
            network: 'Connection error. Please try again.',
          },
        };
        document.querySelectorAll('form[data-newsletter]').forEach(function (form) {
          form.addEventListener('submit', async function (e) {
            e.preventDefault();
            var input = form.querySelector('input[type="email"]');
            var btn = form.querySelector('button[type="submit"]');
            var origText = btn.textContent;
            var lang = (document.documentElement.lang || 'de').toLowerCase().startsWith('en') ? 'en' : 'de';
            btn.textContent = '...';
            btn.disabled = true;
            try {
              // Feldnamen exakt wie im Brevo-Einbettungscode:
              //   EMAIL                -- gross geschrieben, nicht email_address
              //   email_address_check  -- Honigtopf, muss LEER mitgeschickt werden
              //   locale, html_type    -- Brevo generiert beide Formulare mit
              //                           locale=de (Kontosprache). Steuert nur
              //                           Brevos eigene Formularseiten, die wir
              //                           nie anzeigen. Deshalb bewusst so
              //                           uebernommen, statt fuer EN zu raten.
              var body = new URLSearchParams({
                EMAIL: input.value,
                email_address_check: '',
                locale: 'de',
                html_type: 'simple',
              });
              var res = await fetch(BREVO_FORM[lang], {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/x-www-form-urlencoded',
                  Accept: 'application/json',
                },
                body: body.toString(),
              });
              // Brevo antwortet 200 mit {"success":true}. Ein 200 mit
              // success:false waere ein fachlicher Fehler trotz HTTP-OK.
              var ok = res.ok;
              if (ok) {
                try {
                  var data = await res.json();
                  if (data && data.success === false) ok = false;
                } catch (parseErr) {
                  // Kein JSON zurueck: HTTP-Status entscheidet, wie vorher.
                }
              }
              if (ok) {
                form.innerHTML = '<p style="color:inherit;font-size:0.95rem;">' + messages[lang].success + '</p>';
              } else {
                btn.textContent = origText;
                btn.disabled = false;
                alert(messages[lang].error);
              }
            } catch (err) {
              btn.textContent = origText;
              btn.disabled = false;
              alert(messages[lang].network);
            }
          });
        });
      })();
      // Theme-Toggle (Header): hell <-> dunkel, Wahl bleibt gespeichert.
      // Icon-Wechsel macht CSS ueber html[data-theme] (SVG-Icons im Button);
      // hier wird nur noch der aria-Zustand gepflegt.
      (function () {
        var btns = document.querySelectorAll('[data-theme-toggle]');
        function apply() {
          var dark = document.documentElement.dataset.theme === 'dark';
          btns.forEach(function (b) {
            b.setAttribute('aria-pressed', dark ? 'true' : 'false');
          });
        }
        btns.forEach(function (b) {
          b.addEventListener('click', function () {
            if (document.documentElement.dataset.theme === 'dark') {
              delete document.documentElement.dataset.theme;
              localStorage.removeItem('wg-theme');
            } else {
              document.documentElement.dataset.theme = 'dark';
              localStorage.setItem('wg-theme', 'dark');
            }
            apply();
          });
        });
        apply();
      })();
    </script>
    {
      /* GoatCounter 1:1 wie Ist (ungated, Zaehlkontinuitaet), nur im Prod-Build */
      import.meta.env.PROD && (
        <script
          is:inline
          data-goatcounter="https://wildgewachsen.goatcounter.com/count"
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }
  </body>
</html>
