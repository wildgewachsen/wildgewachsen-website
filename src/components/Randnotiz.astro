---
// Handschriftliche Randnotiz (Caveat, Terrakotta) fuer den Artikel-Body.
// Mobil im Textfluss, ab 1100px als echte Randspalte neben der .prose-Spalte.
// Kein JS. role="note" statt Landmark, damit viele Notizen keinen Laerm machen.
interface Props {
  ausrichtung?: 'links' | 'rechts';
  pfeil?: boolean;
  lang?: 'de' | 'en';
}

const { ausrichtung = 'rechts', pfeil = false, lang = 'de' } = Astro.props;

const label = lang === 'de' ? 'Randnotiz' : 'Margin note';
---

<aside
  class:list={['randnotiz', `randnotiz--${ausrichtung}`]}
  role="note"
  aria-label={label}
>
  {
    pfeil && (
      <svg
        class="randnotiz__pfeil"
        viewBox="0 0 64 40"
        width="64"
        height="40"
        aria-hidden="true"
        fill="none"
      >
        {/* Handgezeichneter Schwung-Pfeil, zeigt Richtung Text */}
        <path
          d="M6 6 C 14 26, 30 34, 52 24"
          stroke="var(--accent-strong)"
          stroke-width="2"
          stroke-linecap="round"
        />
        <path
          d="M44 19 L 53 24 L 45 32"
          stroke="var(--accent-strong)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
  <p class="randnotiz__text"><slot /></p>
</aside>

<style>
  /* Mobil: im Textfluss, leicht gedreht wie eine Notiz am Seitenrand */
  .randnotiz {
    font-family: var(--font-hand);
    font-size: var(--text-1);
    line-height: 1.3;
    color: var(--accent-strong);
    max-inline-size: 30ch;
    rotate: -1.5deg;
  }

  .randnotiz--rechts {
    rotate: 1deg;
    margin-inline-start: auto;
    text-align: right;
  }

  .randnotiz__text {
    margin: 0;
  }

  .randnotiz__pfeil {
    display: block;
    margin-block-end: var(--space-1);
  }

  .randnotiz--rechts .randnotiz__pfeil {
    margin-inline-start: auto;
    scale: -1 1; /* Pfeil zeigt zurueck Richtung Text */
  }

  /* Ab 1100px: echte Randspalte, haengt per Float + Negativ-Margin
     ausserhalb der .prose-Spalte und nimmt keinen Platz im Fluss ein */
  @media (min-width: 1100px) {
    .randnotiz {
      width: 10rem;
      max-inline-size: none;
      margin-block-start: 0.3em;
    }

    .randnotiz--links {
      float: inline-start;
      clear: inline-start;
      margin-inline-start: calc(-10rem - var(--space-6));
      text-align: right;
    }

    .randnotiz--rechts {
      float: inline-end;
      clear: inline-end;
      margin-inline-end: calc(-10rem - var(--space-6));
      text-align: left;
    }

    .randnotiz--links .randnotiz__pfeil {
      margin-inline-start: auto; /* Pfeil sitzt an der Textkante */
    }

    .randnotiz--rechts .randnotiz__pfeil {
      margin-inline-start: 0;
    }
  }
</style>
