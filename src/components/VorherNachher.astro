---
// Vorher/Nachher-Bildvergleich (Reisetagebuch-Look).
// Unteres Bild = nachher, oberes Bild = vorher, per clip-path beschnitten.
// Griff ist ein nativer Range-Input (Tastatur + Touch), Position via --pos.
interface Bild {
  src: string;
  alt: string;
  label: string;
}

interface Props {
  vorher: Bild;
  nachher: Bild;
  lang?: 'de' | 'en';
  startProzent?: number;
  /* Seitenverhaeltnis des Rahmens, haelt beide Bilder deckungsgleich */
  ratio?: string;
}

const { vorher, nachher, lang = 'de', startProzent = 50, ratio = '3 / 2' } = Astro.props;
const start = Math.min(100, Math.max(0, Math.round(startProzent)));

const t = {
  de: { regler: 'Bildvergleich: Regler mit Pfeiltasten oder durch Ziehen bewegen' },
  en: { regler: 'Image comparison: move the slider with arrow keys or by dragging' },
}[lang];

const hatCaption = Astro.slots.has('default');
---

<figure
  class="vn"
  data-vn
  data-label-vorher={vorher.label}
  data-label-nachher={nachher.label}
  style={`--pos: ${start}%`}
>
  <div class="vn__frame" style={`--ratio: ${ratio}`}>
    <img class="vn__img" src={nachher.src} alt={nachher.alt} loading="lazy" decoding="async" />
    <div class="vn__top">
      <img class="vn__img" src={vorher.src} alt={vorher.alt} loading="lazy" decoding="async" />
    </div>
    <span class="vn__label vn__label--vorher">{vorher.label}</span>
    <span class="vn__label vn__label--nachher">{nachher.label}</span>
    <div class="vn__handle" aria-hidden="true">
      <span class="vn__grip"></span>
    </div>
    <input
      class="vn__range"
      type="range"
      min="0"
      max="100"
      step="1"
      value={start}
      aria-label={t.regler}
    />
  </div>
  {
    hatCaption && (
      <figcaption class="vn__caption">
        <slot />
      </figcaption>
    )
  }
</figure>

<style>
  /* Polaroid-Rahmen: Creme, unten dicker */
  .vn {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    box-shadow: var(--shadow-card);
    padding: var(--space-2) var(--space-2) var(--space-4);
  }

  .vn__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--ratio);
    border-radius: var(--radius-s);
    background: var(--bg);
  }

  .vn__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vn__top {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  /* Etiketten-Labels, Courier Prime, leicht gedreht */
  .vn__label {
    position: absolute;
    top: var(--space-3);
    z-index: 2;
    pointer-events: none;
    max-width: 45%;
    padding: var(--space-1) var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text--1);
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink);
    background: var(--surface);
    border: 1px dashed var(--ink-soft);
    border-radius: var(--radius-s);
  }

  .vn__label--vorher {
    left: var(--space-3);
    rotate: -1deg;
  }

  .vn__label--nachher {
    right: var(--space-3);
    rotate: 1deg;
  }

  /* Griff-Linie + Griff (rein visuell, Interaktion macht der Range-Input) */
  .vn__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    z-index: 3;
    width: 2px;
    margin-left: -1px;
    background: var(--surface);
    pointer-events: none;
  }

  .vn__grip {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: var(--shadow-card);
    transition: scale 120ms ease;
  }

  .vn__grip::before,
  .vn__grip::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 0.5rem;
    height: 0.5rem;
    border: solid var(--accent-contrast);
    border-width: 2px 2px 0 0;
  }

  .vn__grip::before {
    left: 0.55rem;
    transform: translateY(-50%) rotate(-135deg);
  }

  .vn__grip::after {
    right: 0.55rem;
    transform: translateY(-50%) rotate(45deg);
  }

  .vn__frame:hover .vn__grip {
    scale: 1.08;
  }

  /* Range-Input: unsichtbar, aber voll bedienbar (Maus, Touch, Tastatur) */
  .vn__range {
    position: absolute;
    inset: 0;
    z-index: 4;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    cursor: ew-resize;
  }

  .vn__range::-webkit-slider-runnable-track {
    background: transparent;
    border: 0;
  }

  .vn__range::-moz-range-track {
    background: transparent;
    border: 0;
  }

  .vn__range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 2.75rem;
    height: 100%;
    background: transparent;
    border: 0;
  }

  .vn__range::-moz-range-thumb {
    width: 2.75rem;
    height: 100%;
    background: transparent;
    border: 0;
    border-radius: 0;
  }

  .vn__range:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: -3px;
    border-radius: var(--radius-s);
  }

  /* Handschrift-Bildunterschrift, Caveat immer Terrakotta */
  .vn__caption {
    padding-top: var(--space-3);
    font-family: var(--font-hand);
    font-size: var(--text-1);
    line-height: 1.3;
    color: var(--accent-strong);
    text-align: center;
    rotate: -0.5deg;
  }

  @media (prefers-reduced-motion: reduce) {
    .vn__grip {
      transition: none;
    }
  }
</style>

<script>
  // Mehrfach-Instanzen-sicher: kein getElementById, alles ueber closest.
  const setPos = (range: HTMLInputElement) => {
    const root = range.closest<HTMLElement>('[data-vn]');
    if (!root) return;
    const v = Math.round(Number(range.value));
    root.style.setProperty('--pos', `${v}%`);
    const vor = root.dataset.labelVorher ?? '';
    const nach = root.dataset.labelNachher ?? '';
    range.setAttribute('aria-valuetext', `${vor} ${v}%, ${nach} ${100 - v}%`);
  };

  document
    .querySelectorAll<HTMLInputElement>('[data-vn] input[type="range"]')
    .forEach((range) => {
      setPos(range);
      range.addEventListener('input', () => setPos(range));
    });
</script>
