          <input type="email" placeholder="Deine E-Mail-Adresse" required aria-label="Deine E-Mail-Adresse" />
          <button type="submit">Abonnieren</button>
        </form>
        <p class="newsletter-hinweis">Du kannst dich jederzeit abmelden.</p>
      </div>
    </div>
  </section>
</ArtikelLayout>

<style>
  .newsletter-karte {
    display: grid;
    gap: var(--space-3);
    rotate: -0.5deg;
  }

  .newsletter-form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-2);
  }

  .newsletter-form input {
    flex: 1;
    min-width: 220px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-body);
    color: var(--ink);
  }

  .newsletter-form button {
    background: var(--accent);
    color: var(--accent-contrast);
    border: none;
    border-radius: var(--radius-s);
    padding: var(--space-3) var(--space-5);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
  }

  .newsletter-form button:hover {
    background: var(--accent-strong);
  }

  .newsletter-hinweis {
    font-family: var(--font-mono);
    font-size: var(--text--1);
    color: var(--ink-soft);
  }
</style>

<style>
  /* --- Inhaltsverzeichnis ---------------------------------------
     StickyToc erwartet ab 1100px eine Spalte vom Parent-Layout.
     Im Ein-Spalten-Artikel: bis 1439px als Aufklappbox im Fluss,
     ab 1440px als sticky Randspalte links neben der Lese-Spalte. */
  :global(.prose) {
    position: relative;
  }

  @media (min-width: 1100px) and (max-width: 1439.98px) {
    .toc-halter :global(.toc) {
      position: static;
    }

    .toc-halter :global(.toc__box--desktop) {
      display: none;
    }

    .toc-halter :global(.toc__box--mobile) {
      display: block;
    }
  }

  @media (min-width: 1440px) {
    .toc-halter {
      position: absolute;
      inset-block: 0;
      inset-inline-start: calc(-240px - var(--space-7));
      width: 240px;
      margin: 0;
    }
  }

  /* --- Kosten-Tabelle -------------------------------------------- */
  .kosten-tabelle {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text--1);
  }

  .kosten-tabelle th {
    text-align: left;
    font-family: var(--font-mono);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
    padding: var(--space-2);
    border-bottom: 1px solid var(--line);
  }

  .kosten-tabelle td {
    padding: var(--space-2);
    border-bottom: 1px dashed var(--line);
    vertical-align: top;
  }

  .kosten-tabelle tbody tr:last-child td {
    border-bottom: none;
  }

  /* --- Trust Box ------------------------------------------------- */
  .trust-box {
    background: var(--surface);
    border: 1px dashed var(--line);
    border-radius: var(--radius-s);
    padding: var(--space-5);
    font-size: var(--text--1);
    color: var(--ink-soft);
  }

  .trust-box p + p {
    margin-block-start: var(--space-3);
  }

  /* --- Update-Log ------------------------------------------------ */
  .update-log {
    font-family: var(--font-mono);
    font-size: var(--text--1);
  }

  .update-log__titel {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-soft);
    margin-block-end: var(--space-2);
  }

  .update-log__eintrag {
    display: flex;
    gap: var(--space-4);
    padding-block: var(--space-2);
    border-top: 1px dashed var(--line);
  }

  .update-log__datum {
    flex: none;
    color: var(--ink-soft);
  }

  /* --- Autor-Box ------------------------------------------------- */
  .author-box {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-card);
    padding: var(--space-5);
  }

  .author-box__avatar {
    flex: none;
  }

  .author-box__avatar img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-box__name {
    font-family: var(--font-display);
    font-size: var(--text-1);
  }

  .author-box__bio {
    margin-block-start: var(--space-2);
    font-size: var(--text--1);
    color: var(--ink-soft);
  }
</style>
