---
import ArtikelLayout from '../../layouts/ArtikelLayout.astro';
import StickyToc from '../../components/StickyToc.astro';
import Randnotiz from '../../components/Randnotiz.astro';
import PullQuote from '../../components/PullQuote.astro';
import AufklappBox from '../../components/AufklappBox.astro';
import WeiterlesenPfade from '../../components/WeiterlesenPfade.astro';
import FotoStory from '../../components/FotoStory.astro';
import InlineVideo from '../../components/InlineVideo.astro';

// ─────────────────────────────────────────────────────────────────────────────
// EINE Datenquelle, zwei Auftritte: oben unsere Bilanz, unten die Leser-Liste.
// Belege: video_katalog/catalog.json + video_katalog/transkripte/
// Dokumentiert in blog-drafts/b13-tiere-bestandsaufnahme.md
// "tage" = an wie vielen verschiedenen Tagen wir das Tier gesehen haben.
// ─────────────────────────────────────────────────────────────────────────────
const tiere = [
  // Am Wasser
  { name: 'Dolphin',           ast: 'wasser', gesehen: '2026-06-25', tage: 2, saison: null,      zeichnung: true,  notiz: 'Am ersten Tag, eine Flosse im Wasser.' },
  { name: 'Humpback Whale',    ast: 'wasser', gesehen: '2026-07-03', tage: 2, saison: [5, 11],   zeichnung: true,  notiz: 'Erst eine Fontäne weit draußen. Später einer direkt neben den Surfern.' },
  { name: 'Shark',             ast: 'wasser', gesehen: '2026-07-04', tage: 1, saison: null,      zeichnung: true,  notiz: 'Von der Klippe aus. Ich habe unten Bescheid gesagt.' },
  { name: 'Pelican',           ast: 'wasser', gesehen: '2026-07-03', tage: 1, saison: null,      zeichnung: false, notiz: 'Tief über der Flussmündung.' },
  { name: 'Sea Eagle',         ast: 'wasser', gesehen: null,         tage: 0, saison: null,      zeichnung: false, notiz: null },
  { name: 'Sea Turtle',        ast: 'wasser', gesehen: null,         tage: 0, saison: null,      zeichnung: false, notiz: null },

  // Im Wald und Busch
  { name: 'Koala',             ast: 'busch',  gesehen: '2026-07-04', tage: 2, saison: null,      zeichnung: true,  notiz: 'Beim Joggen. Andere Leute standen schon da und schauten hoch.' },
  { name: 'Wallaby',           ast: 'busch',  gesehen: '2026-07-20', tage: 2, saison: null,      zeichnung: true,  notiz: 'Auf das haben wir am längsten gewartet.' },
  { name: 'Echidna',           ast: 'busch',  gesehen: '2026-06-30', tage: 2, saison: null,      zeichnung: true,  notiz: 'Wühlte im Laub am Fuß eines morschen Stamms.' },
  { name: 'Water Dragon',      ast: 'busch',  gesehen: '2026-07-29', tage: 1, saison: null,      zeichnung: true,  notiz: 'Saß regungslos auf einem Stein. Nackenkamm, rötliche Brust.' },
  { name: 'Green Tree Snake',  ast: 'busch',  gesehen: '2026-09-03', tage: 2, saison: null,      zeichnung: true,  notiz: 'Wohnt an der Natursteinmauer am Pool. Am 3. und am 14. September an derselben Stelle.' },
  { name: 'Python',            ast: 'busch',  gesehen: '2026-09-03', tage: 2, saison: null,      zeichnung: true,  notiz: 'Erst nachts im Gebüsch, im Licht der Taschenlampe. Später eine zweite, aufgerollt in einer Felsspalte.' },
  { name: 'Goanna',            ast: 'busch',  gesehen: '2026-09-05', tage: 1, saison: null,      zeichnung: false, notiz: 'Joris hat ihn entdeckt. Bis ich draußen war, war er im Gebüsch.' },
  { name: 'Kangaroo',          ast: 'busch',  gesehen: null,         tage: 0, saison: null,      zeichnung: false, notiz: null },

  // Im Garten und am Haus
  { name: 'Brush Turkey',      ast: 'garten', gesehen: '2026-06-25', tage: 1, saison: null,      zeichnung: true,  notiz: 'Das allererste Tier, noch am Ankunftstag, am Zaun neben dem Küstenpfad.' },
  { name: 'Kookaburra',        ast: 'garten', gesehen: '2026-06-28', tage: 3, saison: null,      zeichnung: true,  notiz: 'Einmal auf einem rostigen Wegweiser, zweimal auf einer Gartenfigur.' },
  { name: 'Huntsman',          ast: 'garten', gesehen: '2026-07-03', tage: 4, saison: null,      zeichnung: true,  notiz: 'Im Haus, am Poolkescher, in der Mülltonne und nachts an der Hauswand.' },
  { name: 'Cockatoo',          ast: 'garten', gesehen: '2026-08-04', tage: 1, saison: null,      zeichnung: false, notiz: 'Hell und cremefarben, oben in der Baumkrone über dem Spielplatz.' },
  { name: 'Gecko',             ast: 'garten', gesehen: '2026-08-28', tage: 1, saison: null,      zeichnung: false, notiz: 'Am Deckenbalken, später auf der Decke auf dem Sofa.' },
  { name: 'Rainbow Lorikeet',  ast: 'garten', gesehen: null,         tage: 0, saison: null,      zeichnung: false, notiz: null },
  { name: 'White Ibis',        ast: 'garten', gesehen: null,         tage: 0, saison: null,      zeichnung: false, notiz: null },

  // Nachts
  { name: 'Flying Fox',        ast: 'nacht',  gesehen: '2026-06-26', tage: 1, saison: null,      zeichnung: true,  notiz: 'Hingen kopfüber im Baum, nach dem Regen.' },
  { name: 'Cane Toad',         ast: 'nacht',  gesehen: '2026-08-25', tage: 3, saison: null,      zeichnung: false, notiz: 'Auf der Veranda. Lucy hat sie mit dem Besen über die Kante geschoben.' },
  { name: 'Possum',            ast: 'nacht',  gesehen: null,         tage: 0, saison: null,      zeichnung: false, notiz: null },
];

const aeste = [
  { id: 'wasser', label: 'Am Wasser',          hinweis: 'Von der Landzunge oder vom Strand aus. Fernglas hilft mehr als jede App.' },
  { id: 'busch',  label: 'Im Wald und Busch',  hinweis: 'Früh morgens und in der Dämmerung. Langsam gehen, oft nach oben schauen.' },
  { id: 'garten', label: 'Im Garten und am Haus', hinweis: 'Die meisten Begegnungen passieren hier, nicht in der Wildnis.' },
  { id: 'nacht',  label: 'Nachts',             hinweis: 'Ohren statt Augen. Vieles hört man lange, bevor man es sieht.' },
];

const gesehenAnzahl = tiere.filter((t) => t.gesehen).length;
const gesamt = tiere.length;

const tocEintraege = [
  { id: 'bilanz',       label: 'Unsere Bilanz nach drei Monaten' },
  { id: 'erste-tage',   label: 'Die ersten Begegnungen' },
  { id: 'wale',         label: 'Wale, und wie man sie verpasst' },
  { id: 'wallaby',      label: 'Das Wallaby, auf das wir warten mussten' },
  { id: 'schlangen',    label: 'Schlangen: was die Zahlen sagen' },
  { id: 'regenwald',    label: 'Nachtrag: der Regenwald' },
  { id: 'gibt-es-nicht',label: 'Was es hier nicht gibt' },
  { id: 'deine-liste',  label: 'Deine Liste zum Mitnehmen' },
  { id: 'faq',          label: 'Häufige Fragen' },
];

const monate = ['J', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'];
---

<ArtikelLayout
  title="Gefährliche Tiere in Australien: was uns in drei Monaten wirklich begegnet ist"
  seoTitle="Gefährliche Tiere in Australien: unsere Erfahrung mit Kindern"
  description="Drei Monate mit zwei kleinen Kindern an der Ostküste: 18 Tierarten selbst gesehen, drei Schlangen, keine gefährliche Situation. Was die Statistik dazu sagt."
  lang="de"
  eyebrow="Alltag in Australien"
  datum="15. September 2026"
  lesezeit="15 Minuten"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://wildgewachsen-australien.de/blog/gefaehrliche-tiere-australien-familie-erfahrung" />
    <link rel="alternate" hreflang="de" href="https://wildgewachsen-australien.de/blog/gefaehrliche-tiere-australien-familie-erfahrung" />
    <link rel="alternate" hreflang="en" href="https://wildgewachsen-australien.de/en/dangerous-animals-australia-family-experience" />
    <link rel="alternate" hreflang="x-default" href="https://wildgewachsen-australien.de/blog/gefaehrliche-tiere-australien-familie-erfahrung" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Wildgewachsen" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:locale:alternate" content="en_GB" />
    <meta property="og:title" content="Gefährliche Tiere in Australien: was uns in drei Monaten wirklich begegnet ist" />
    <meta property="og:description" content="18 Tierarten selbst gesehen, drei Schlangen, keine gefährliche Situation. Was die Statistik wirklich sagt." />
    <meta property="og:url" content="https://wildgewachsen-australien.de/blog/gefaehrliche-tiere-australien-familie-erfahrung" />
    <meta property="og:image" content="https://wildgewachsen-australien.de/assets/images/au-buckelwal-drohne-byron-og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Gefährliche Tiere in Australien: unsere Erfahrung mit Kindern" />
    <meta name="twitter:description" content="18 Tierarten selbst gesehen, drei Schlangen, keine gefährliche Situation." />
    <meta name="twitter:image" content="https://wildgewachsen-australien.de/assets/images/au-buckelwal-drohne-byron-og.jpg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: 'Gefährliche Tiere in Australien: was uns in drei Monaten wirklich begegnet ist',
      description: 'Drei Monate an der australischen Ostküste mit zwei kleinen Kindern: 18 Tierarten selbst gesehen, drei Schlangen, keine gefährliche Situation.',
      datePublished: '2026-09-03',
      dateModified: '2026-09-15',
      inLanguage: 'de-DE',
      image: {
        '@type': 'ImageObject',
        url: 'https://wildgewachsen-australien.de/assets/images/au-buckelwal-drohne-byron-og.jpg',
        width: 1200,
        height: 630,
        creditText: 'wildgewachsen',
        license: 'https://wildgewachsen-australien.de/impressum',
        acquireLicensePage: 'https://wildgewachsen-australien.de/kontakt',
      },
      author: { '@type': 'Person', name: 'Christian', url: 'https://wildgewachsen-australien.de/ueber-uns' },
      publisher: {
        '@type': 'Organization',
        name: 'wildgewachsen',
        url: 'https://wildgewachsen-australien.de',
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': 'https://wildgewachsen-australien.de/blog/gefaehrliche-tiere-australien-familie-erfahrung',
      },
    })} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://wildgewachsen-australien.de/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://wildgewachsen-australien.de/blog' },
        { '@type': 'ListItem', position: 3, name: 'Gefährliche Tiere in Australien' },
      ],
    })} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Wie gefährlich sind Schlangen in Australien wirklich?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Im Australian Snakebite Project wurden zwischen Juli 2005 und Juni 2015 insgesamt 23 Todesfälle durch Schlangenbisse erfasst, im Mittel zwei pro Jahr. Im selben Zeitraum kamen 1548 Menschen mit Verdacht auf Schlangenbiss ins Krankenhaus, bei 835 davon wirkte tatsächlich Gift. 17 der 23 Todesfälle gingen auf Brown Snakes zurück.',
          },
        },
        {
          '@type': 'Question',
          name: 'Wie kommt es zu Schlangenbissen in Australien?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'In 47,1 Prozent der erfassten Fälle war die gebissene Person unterwegs oder mit etwas anderem beschäftigt und ahnungslos in der Nähe der Schlange. In 14 Prozent versuchte sie, die Schlange zu fangen oder zu töten, in 8,3 Prozent passierte es bei der Gartenarbeit. In 52 Prozent traf der Biss das Bein.',
          },
        },
        {
          '@type': 'Question',
          name: 'Gibt es in Byron Bay Saltwater Crocodiles?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Nein. Das Saltwater Crocodile kommt an der Ostküste nur bis etwa Gladstone und Rockhampton in Queensland vor. Byron Bay liegt rund tausend Kilometer weiter südlich in New South Wales, weit außerhalb des Verbreitungsgebiets.',
          },
        },
        {
          '@type': 'Question',
          name: 'Wann kann man in Byron Bay Wale sehen?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Humpback Whales ziehen zwischen Mai und November an der Ostküste vorbei. Cape Byron liegt als östlichster Punkt Australiens direkt auf der Wanderroute. Wir haben unsere ersten Wale am 3. Juli gesehen.',
          },
        },
        {
          '@type': 'Question',
          name: 'Sind Pythons in Australien gefährlich?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Pythons sind ungiftig. Sie töten ihre Beute nicht durch Gift, sondern indem sie sich um sie wickeln und sie ersticken. Für Menschen sind die Arten hier keine Lebensgefahr. Ein Biss kann trotzdem wehtun und gehört wie jede Bisswunde ärztlich angesehen. Abstand halten und das Tier in Ruhe lassen reicht völlig.',
          },
        },
        {
          '@type': 'Question',
          name: 'Muss ich mir mit kleinen Kindern in Australien mehr Sorgen um Tiere machen?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Wir sind mit zwei kleinen Kindern hier und hatten in drei Monaten keine einzige gefährliche Situation, auch nicht im Regenwald, wo Schlangen zum Grundstück gehören. Geändert haben sich Gewohnheiten: feste Schuhe im Busch, auf dem Weg bleiben, nachts Licht mitnehmen, nichts anfassen. Nach zwei Wochen macht man das automatisch.',
          },
        },
      ],
    })} />
  </Fragment>

  <div slot="hero" class="hero-video">
    <InlineVideo
      src="/assets/images/au-buckelwal-loop.mp4"
      poster="/assets/images/au-buckelwal-drohne-byron.jpg"
      caption="26. Juli, vor Byron Bay. Ich war losgezogen, um Wale zu filmen, und hatte den halben Tag keine gefunden."
      lang="de"
      aspectRatio="16 / 9"
    />
  </div>

  <div class="toc-halter">
    <StickyToc eintraege={tocEintraege} lang="de" />
  </div>

  <div class="info-box">
    <p class="info-box__titel">Das Wichtigste in Kürze</p>
    <ul>
      <li>In drei Monaten haben wir <strong>{gesehenAnzahl} Tierarten</strong> selbst gesehen, vom Dolphin am Ankunftstag bis zum Goanna im eigenen Garten.</li>
      <li><strong>Drei Schlangen</strong>, zwei davon seit dem Umzug in den Regenwald. Eine Green Tree Snake wohnt an der Steinmauer neben dem Pool. Gefährlich wurde bis heute keine Begegnung.</li>
      <li>Laut Australian Snakebite Project sterben in Australien <strong>im Mittel zwei Menschen pro Jahr</strong> an Schlangenbissen. Fast die Hälfte aller Bisse passiert, weil jemand ahnungslos in der Nähe war.</li>
      <li><strong>Saltwater Crocodile und Cassowary gibt es hier nicht</strong>, und auch den Wombat sucht man an dieser Küste vergeblich. Alle drei leben woanders.</li>
      <li>Unten findest du eine <strong>Liste zum Abhaken und Ausdrucken</strong> für deine eigene Zeit hier.</li>
    </ul>
  </div>

  <p>
    „Was ist mit den ganzen gefährlichen Tieren?" Die Frage hört man vorher oft. Sieht man die überhaupt im Alltag? Und wenn ja, wie ist das wirklich?
  </p>

  <p>
    Ich kann das inzwischen beantworten, aber nicht so, wie man es erwartet. Wir sind <a href="/blog/angekommen-erste-tage-australien">am 25. Juni in Byron Bay angekommen</a>. Was seitdem passiert ist, war weniger dramatisch und deutlich schöner, als ich selbst gedacht hätte. Und der eine Moment, in dem es wirklich um etwas ging, kam nicht von einem Tier, sondern von einer Nachbarin und ihrer Geschichte.
  </p>

  <h2 id="bilanz">Unsere Bilanz nach drei Monaten</h2>

  <p>
    Das hier ist keine Liste von Tieren, die es in Australien gibt. Das ist die Liste der Tiere, die wir mit eigenen Augen gesehen haben, mit Datum, an der Ostküste zwischen Byron Bay und dem Hinterland. Jedes Feld mit Stempel steht für einen Tag, an dem wir dastanden und geschaut haben.
  </p>

  <figure class="pass">
    <figcaption class="pass__kopf">
      <span class="pass__titel">Unser Sichtungs-Pass</span>
      <span class="pass__zaehler">{gesehenAnzahl}<span class="pass__von">/{gesamt}</span></span>
    </figcaption>
    <div class="pass__gitter">
      {tiere.map((t) => (
        <div class={t.gesehen ? 'stempel stempel--voll' : 'stempel stempel--leer'}>
          <span class="stempel__name">{t.name}</span>
          {t.gesehen ? (
            <span class="stempel__datum">{new Date(t.gesehen).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit' })}</span>
          ) : (
            <span class="stempel__offen">offen</span>
          )}
        </div>
      ))}
    </div>
    <p class="pass__fuss">
      Gestempelt heißt: selbst gesehen. Nicht im Zoo, nicht auf einer Tour, nicht auf dem Handy von jemand anderem.
    </p>
  </figure>

  <Randnotiz ausrichtung="rechts" pfeil={true} lang="de">
    Sechs Felder sind noch leer. Das Possum höre ich fast jede Nacht über dem Dach. Gesehen habe ich es bis heute nicht.
  </Randnotiz>

  <figure class="artikel-figur artikel-figur--alt">
    <picture>
      <source srcset="/assets/images/au-kaenguru-mit-joey-p960.webp" type="image/webp" />
      <img
        src="/assets/images/au-kaenguru-mit-joey-p960.jpg"
        width="720"
        height="960"
        alt="Kangaroo auf einer Rasenfläche, im Beutel schaut ein Jungtier heraus, im Vordergrund unscharf eine Schulter."
        loading="lazy"
      />
    </picture>
    <figcaption>
      <strong>Nicht aus diesen drei Monaten.</strong> Ein großes Kangaroo haben wir seit dem 25. Juni nicht gesehen. Dieses Bild ist vom Januar 2018, aus unserer früheren Zeit in Australien. Es steht hier für das, worauf wir noch warten.
    </figcaption>
  </figure>

  <h2 id="erste-tage">Die ersten Begegnungen</h2>

  <p>
    Das erste spannende Tier war keine Schlange, keine Spinne und kein Meeresbewohner. Am Ankunftstag lief neben dem Küstenpfad ein dunkler, hühnergroßer Vogel am Zaun entlang und scharrte im Laub. Kein Kangaroo, kein Koala. Ein Brush Turkey. Ich mag die Tiere. Am Strand sollte man sein Essen trotzdem im Blick behalten. Ich habe selbst gesehen, wie sie Zip-Beutel aufbekommen und Chipstüten aufreißen.
  </p>

  <p>
    Am selben Tag dann, vom Strand aus, eine Rückenflosse im Wasser. Dolphins, an Tag eins. Damit hatte ich nicht gerechnet.
  </p>

  <p>
    Am nächsten Abend hingen Flying Foxes kopfüber in einem Baum, die Blätter noch nass vom Regen. Drei Tage später saß ein Kookaburra auf einem Wegweiser zum Strand und ließ sich in Ruhe ansehen.
  </p>

  <FotoStory
    lang="de"
    ueberschrift="Die erste Woche"
    bilder={[
      {
        src: '/assets/images/au-buschhuhn-zaun-byron.jpg',
        alt: 'Brush Turkey mit rotem Kopf und gelbem Kehllappen scharrt im Laub an einem Zaunpfosten neben dem Küstenpfad.',
        caption: '25. Juni: das allererste Tier. Ein Brush Turkey am Zaun, kein Kangaroo.',
      },
      {
        src: '/assets/images/au-delfin-finne-tag-eins.jpg',
        alt: 'Dunkler Dolphin-Rücken mit Finne durchbricht die graue Wasseroberfläche, weit vom Strand entfernt.',
        caption: 'Am selben Tag, weit draußen: eine Rückenflosse. Mehr war nicht zu sehen, und es reichte.',
      },
      {
        src: '/assets/images/au-flughunde-baum-byron.jpg',
        alt: 'Mehrere Flying Foxes hängen kopfüber mit zusammengefalteten Flügeln in den Ästen eines Baumes, rostrotes Nackenfell.',
        caption: '26. Juni: Flying Foxes im Baum, die Blätter noch nass vom Regen.',
      },
      {
        src: '/assets/images/au-kookaburra-wegweiser.jpg',
        alt: 'Kookaburra sitzt auf einem roten Wegweiser mit der Aufschrift Beach Access, dahinter grüne Sträucher.',
        caption: '28. Juni: der Kookaburra saß da, bis ich nah genug war.',
      },
    ]}
  />

  <p>
    Am 30. Juni wühlte ein Echidna im Laub am Fuß eines morschen Stamms, so nah, dass ich mich nicht bewegen wollte. Auf einem Foto sieht so ein Tier aus wie ein Stachelball. Erst wenn es sich bewegt, sieht man den Unterschied.
  </p>

  <InlineVideo
    src="/assets/images/au-echidna-loop.mp4"
    poster="/assets/images/au-echidna-loop-poster.jpg"
    caption="30. Juni, Küstenbusch bei Byron Bay. Sechs Sekunden, ohne Ton."
    lang="de"
    aspectRatio="9/16"
  />

  <PullQuote quelle="Aus dem Video vom 4. Juli" lang="de">
    Ich wollte joggen. Es wurde mehr Stehenbleiben als Laufen.
  </PullQuote>

  <p>
    Der 4. Juli war der Tag, an dem beides passierte. Ich bin den Lighthouse-Walk hochgelaufen, vorne standen Leute und schauten nach oben. Da saß er, grau, in der Astgabel. Mein erster Koala, nach insgesamt über zwei Jahren, die ich vorher schon einmal in diesem Land verbracht hatte. Ein Punkt auf einer Liste, von der ich gar nicht wusste, dass ich sie habe.
  </p>

  <figure class="artikel-figur">
    <picture>
      <source srcset="/assets/images/au-koala-eukalyptus-byron.webp" type="image/webp" />
      <img
        src="/assets/images/au-koala-eukalyptus-byron.jpg"
        width="1200"
        height="1189"
        alt="Koala sitzt grau und zusammengekauert in einer Astgabel, das Gesicht mit Auge und Ohr ist zwischen Blättern zu erkennen."
        loading="lazy"
      />
    </picture>
    <figcaption>So sieht man Koalas wirklich: halb hinter Blättern, und nur weil jemand anderes vorher stehen geblieben ist.</figcaption>
  </figure>

  <p>
    Zwanzig Minuten später, von den Klippen aus, ein dunkler Schatten im türkisen Wasser. Ein Shark, groß, und er schwamm aus der Richtung der Surfer. Ich habe unten Bescheid gesagt. Es schien niemanden zu stören. Ich hatte an dem Tag eigentlich selbst noch surfen wollen und habe es gelassen. Der Respekt war dann doch größer.
  </p>

  <figure class="artikel-figur">
    <picture>
      <source srcset="/assets/images/au-hai-unter-oberflaeche.webp" type="image/webp" />
      <img
        src="/assets/images/au-hai-unter-oberflaeche.jpg"
        width="1200"
        height="1188"
        alt="Blick von oben auf türkisgrünes Wasser, darin eine längliche dunkle Gestalt knapp unter der Oberfläche."
        loading="lazy"
      />
    </picture>
    <figcaption>Mehr war es nicht. Und genau deshalb bin ich an dem Tag nicht mehr rein.</figcaption>
  </figure>

  <h2 id="wale">Wale, und wie man sie verpasst</h2>

  <p>
    Cape Byron ist der östlichste Punkt Australiens und liegt damit direkt auf der Wanderroute der Humpback Whales. Zwischen Mai und November ziehen sie an der Ostküste vorbei, auf dem Weg von der Antarktis nach Norden und später mit den Kälbern wieder zurück.
  </p>

  <figure class="chart-figur">
    <svg viewBox="0 0 300 74" role="img" aria-label="Balkendiagramm: Humpback Whales sind an der Ostküste von Mai bis November zu sehen, mit den höchsten Werten von Juli bis Oktober. Von Dezember bis April sind keine Wale zu erwarten.">
      <title>Wann Humpback Whales vorbeiziehen</title>
      <text x="4" y="10" font-family="Courier Prime, monospace" font-size="8" fill="#695A48">BUCKELWAL — WANN</text>
      {monate.map((m, i) => {
