    .liste__druck:hover { background: var(--accent-strong); color: var(--accent-contrast); }
    .liste__ast { margin-block-end: var(--space-3); }
    .liste__ast > summary {
      font-family: var(--font-display);
      font-size: var(--text-1);
      cursor: pointer;
      padding-block: var(--space-1);
    }
    .liste__hinweis {
      font-family: var(--font-hand);
      color: var(--accent-strong);
      font-size: var(--text-1);
      margin-block: var(--space-1) var(--space-2);
    }
    .liste__eintraege { list-style: none; margin: 0; padding: 0; }
    .liste__eintraege li { border-block-end: 1px dotted var(--line); }
    .liste__eintraege label {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      padding-block: var(--space-2);
      cursor: pointer;
    }
    .liste__eintraege input { inline-size: 17px; block-size: 17px; accent-color: var(--accent-strong); flex: none; }
    .liste__name { font-size: var(--text-0); }
    .liste__saison {
      margin-inline-start: auto;
      font-family: var(--font-mono);
      font-size: var(--text--1);
      color: var(--accent-strong);
    }
    .liste__fuss { font-size: var(--text--1); color: var(--ink-soft); margin-block-end: 0; }

    .trust-box, .update-log {
      font-size: var(--text--1);
      color: var(--ink-soft);
      border-block-start: 1px solid var(--line);
      padding-block-start: var(--space-3);
      margin-block-start: var(--space-5);
    }

    /* ── Druck: nur die Liste, leer, auf einer Seite ─────────────────── */
    @media print {
      body * { visibility: hidden; }
      .liste, .liste * { visibility: visible; }
      .liste {
        position: absolute;
        inset-block-start: 0;
        inset-inline-start: 0;
        inline-size: 100%;
        border: none;
        padding: 0;
      }
      .liste__druck, .liste__fuss { display: none; }
      .liste__ast > summary { break-after: avoid; }
      .liste__eintraege input { appearance: none; border: 1.5px solid #33291f; }
    }
  </style>

  <script>
    // Fortschritt der Leser-Liste, rein lokal im Browser.
    const wurzel = document.querySelector('[data-liste]');
    if (wurzel) {
      const SCHLUESSEL = 'wg-tierliste-v1';
      const kaesten = wurzel.querySelectorAll('input[type="checkbox"]');
      const zaehler = wurzel.querySelector('[data-zaehler]');

      const lies = () => {
        try {
          return JSON.parse(localStorage.getItem(SCHLUESSEL) || '[]');
        } catch {
          return [];
        }
      };
      const schreib = (werte) => {
        try {
          localStorage.setItem(SCHLUESSEL, JSON.stringify(werte));
        } catch {
          /* Privater Modus oder blockierte Speicherung: Liste funktioniert trotzdem. */
        }
      };
      const aktualisiere = () => {
        const an = [...kaesten].filter((k) => k.checked);
        if (zaehler) zaehler.textContent = String(an.length);
        schreib(an.map((k) => k.dataset.tier));
      };

      const gespeichert = lies();
      kaesten.forEach((k) => {
        if (gespeichert.includes(k.dataset.tier)) k.checked = true;
        k.addEventListener('change', aktualisiere);
      });
      if (zaehler) zaehler.textContent = String([...kaesten].filter((k) => k.checked).length);

      wurzel.querySelector('[data-drucken]')?.addEventListener('click', () => window.print());
    }
  </script>
</ArtikelLayout>
