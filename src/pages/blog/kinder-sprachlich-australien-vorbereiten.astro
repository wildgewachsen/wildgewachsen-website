<style>
  /* --- Inhaltsverzeichnis ---------------------------------------
     StickyToc erwartet ab 1100px eine Spalte vom Parent-Layout.
     Im Ein-Spalten-Artikel: bis 1439px als Aufklappbox im Fluss,
     ab 1440px als sticky Randspalte links neben der Lese-Spalte. */
  :global(.prose) {
    position: relative;
  }

  @media (min-width: 1100px) and (max-width: 1439.98px) {
    .toc-halter :global(.toc) {
      position: static;
    }

    .toc-halter :global(.toc__box--desktop) {
      display: none;
    }

    .toc-halter :global(.toc__box--mobile) {
      display: block;
    }
  }

  @media (min-width: 1440px) {
    .toc-halter {
      position: absolute;
      inset-block: 0;
      inset-inline-start: calc(-240px - var(--space-7));
      width: 240px;
      margin: 0;
    }
  }

  /* --- Info-Box (Das Wichtigste in Kürze) ------------------------ */
  .info-box {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-card);
    padding: var(--space-5);
  }

  .info-box__titel {
    font-family: var(--font-mono);
    font-size: var(--text--1);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-soft);
    margin-block-end: var(--space-3);
  }

  .info-box p + p,
  .info-box ul {
    margin-block-start: var(--space-3);
  }

  .info-box ul {
    padding-inline-start: 1.4em;
  }

  .info-box li + li {
    margin-block-start: var(--space-2);
  }

  /* --- Trust Box ------------------------------------------------- */
  .trust-box {
    background: var(--surface);
    border: 1px dashed var(--line);
    border-radius: var(--radius-s);
    padding: var(--space-5);
    font-size: var(--text--1);
    color: var(--ink-soft);
  }

  .trust-box p + p {
    margin-block-start: var(--space-3);
  }

  /* --- Update-Log ------------------------------------------------ */
  .update-log {
    font-family: var(--font-mono);
    font-size: var(--text--1);
  }

  .update-log__titel {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-soft);
    margin-block-end: var(--space-2);
  }

  .update-log__eintrag {
    display: flex;
    gap: var(--space-4);
    padding-block: var(--space-2);
    border-top: 1px dashed var(--line);
  }

  .update-log__datum {
    flex: none;
    color: var(--ink-soft);
  }

  /* --- Autor-Box ------------------------------------------------- */
  .author-box {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-card);
    padding: var(--space-5);
  }

  .author-box__avatar {
    flex: none;
  }

  .author-box__avatar img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-box__name {
    font-family: var(--font-display);
    font-size: var(--text-1);
  }

  .author-box__bio {
    margin-block-start: var(--space-2);
    font-size: var(--text--1);
    color: var(--ink-soft);
  }
</style>
