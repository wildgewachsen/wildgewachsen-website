<style>
  .artikel-bild {
    width: 100%;
    border-radius: var(--radius-m);
  }

  /* --- Inhaltsverzeichnis ---------------------------------------
     StickyToc erwartet ab 1100px eine Spalte vom Parent-Layout.
     Im Ein-Spalten-Artikel: bis 1439px als Aufklappbox im Fluss,
     ab 1440px als sticky Randspalte links neben der Lese-Spalte. */
  :global(.prose) {
    position: relative;
  }

  @media (min-width: 1100px) and (max-width: 1439.98px) {
    .toc-halter :global(.toc) {
      position: static;
    }

    .toc-halter :global(.toc__box--desktop) {
      display: none;
    }

    .toc-halter :global(.toc__box--mobile) {
      display: block;
    }
  }

  @media (min-width: 1440px) {
    .toc-halter {
      position: absolute;
      inset-block: 0;
      inset-inline-start: calc(-240px - var(--space-7));
      width: 240px;
      margin: 0;
    }
  }

  /* --- Etappen-Register (Unikat) ----------------------------------
     Reisetagebuch-Stationen: Abreißkalender-Trenner mit Perforation
     oben, großem Zeitraum in Young Serif und Caveat-Notiz. Ab Desktop
     ragt der Zeitraum leicht in den linken Rand (Register-Effekt). */
  .etappe {
    position: relative;
    display: grid;
    gap: var(--space-1);
    background: var(--surface);
    border: 1px solid var(--line);
    border-block-start: 2px dashed var(--line-strong, var(--line));
    border-radius: 0 0 var(--radius-m) var(--radius-m);
    box-shadow: var(--shadow-card);
    padding: var(--space-5) var(--space-5) var(--space-4);
    margin-block: var(--space-8) var(--space-5);
  }

  /* Perforations-Löcher der Abreißkante */
  .etappe::before {
    content: '';
    position: absolute;
    inset-block-start: -6px;
    inset-inline: var(--space-4);
    height: 10px;
    background-image: radial-gradient(circle at 5px 5px, var(--bg) 3px, transparent 3.5px);
    background-size: 22px 10px;
    background-repeat: repeat-x;
  }

  .etappe__label {
    font-family: var(--font-mono);
    font-size: var(--text--1);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-soft);
