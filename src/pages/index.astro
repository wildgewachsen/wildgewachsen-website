---
// Startseite im neuen Look "Sonnengetrocknete Erde".
// Alle sichtbaren Texte 1:1 aus website/index.html (Live-Stand) portiert.
// Head-Werte (canonical, hreflang, OG/Twitter, Favicons) exakt wie live.
// Klaro-Consent 1:1 uebernommen (public/js + public/css), app.js bewusst NICHT.
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoHero from '../components/VideoHero.astro';
import WeiterlesenPfade from '../components/WeiterlesenPfade.astro';
import HandIcon from '../components/HandIcon.astro';

// Neueste Artikel (neuester zuerst, max. 3) - Texte 1:1 von live
// Stand 22.07.: SIM-Artikel (B7) neu dabei, von der Parallel-Session publiziert
const neuesteArtikel = [
  {
    href: '/blog/australische-sim-karte-handynummer-auswandern',
    meta: 'Geld & Kosten',
    titel: 'Australische SIM-Karte und Handynummer für Auswanderer',
    teaser: '22. Juli 2026 · 9 Min. Lesezeit',
  },
  {
    href: '/blog/angekommen-erste-tage-australien',
    meta: 'Ankommen & Alltag',
    titel: 'Angekommen in Australien: meine ersten Tage allein',
    teaser: '4. Juli 2026 · 7 Min. Lesezeit',
  },
  {
    href: '/blog/entscheidung-auswandern-australien',
    meta: 'Unsere Geschichte',
    titel: 'Die Entscheidung auszuwandern: Warum wir nach Australien gehen',
    teaser: '25. Juni 2026 · 8 Min. Lesezeit',
  },
];

// Hub-Pillars ("Tief eintauchen") - Texte + Bildpfade 1:1 von live
const wegweiser = [
  {
    href: '/blog/vom-gemuesegarten-nach-australien-auswanderung-familie',
    kategorie: 'Unsere Geschichte',
    titel: 'Vom Gemüsegarten nach Australien: Unsere Auswanderung als Familie',
    meta: 'Guide · 14 Min. Lesezeit',
    bild: '/assets/images/family-story.jpg',
  },
  {
    href: '/blog/auswandern-australien-kosten-familie-guide',
    kategorie: 'Geld & Kosten',
    titel:
      'Auswandern nach Australien als Familie: Was es wirklich kostet — unsere echten Zahlen (2026)',
    meta: 'Guide · 13 Min. Lesezeit',
    bild: 'https://cdn.pixabay.com/photo/2021/02/13/03/29/money-6010252_640.jpg',
  },
  {
    href: '/blog/visum-186-australien-familie-guide',
    kategorie: 'Visum & Migration',
    titel:
      'Visum 186 Australien: Unser Familien-Weg zum Employer Sponsored Visa (2026)',
    meta: 'Guide · 12 Min. Lesezeit',
    bild: '/assets/images/artikel-visum-186.jpg',
  },
];

// Themen-Karten - Texte + Filter-Links 1:1 von live.
// Icons: handgezeichnete HandIcon-Namen statt der Alt-Emojis (v2 Playbook).
const themen = [
  {
    href: '/blog?filter=visum-migration',
    icon: 'flugzeug',
    name: 'Visum & Migration',
    desc: 'Skill Assessment, PTE-Test, Visa 186, Behörden-Erfahrungen',
  },
  {
    href: '/blog?filter=vorbereitung-planung',
    icon: 'liste',
    name: 'Vorbereitung & Planung',
    desc: 'Checklisten, Zeitpläne, Dokumente, Entscheidungen',
  },
  {
    href: '/blog?filter=familie-kinder',
    icon: 'herz',
    name: 'Familie & Kinder',
    desc: 'Kinder vorbereiten, Schule, Familienalltag im Umbruch',
  },
  {
    href: '/blog?filter=geld-kosten',
    icon: 'muenze',
    name: 'Geld & Kosten',
    desc: 'Budget, echte Zahlen, Banking, was es wirklich kostet',
  },
  {
    href: '/blog?filter=ankommen-alltag',
    icon: 'haus',
    name: 'Ankommen & Alltag',
    desc: 'Erste Wochen, Wohnung, Integration, neues Leben',
  },
  {
    href: '/blog?filter=byron-bay-region',
    icon: 'welle',
    name: 'Byron Bay & Region',
    desc: 'Ortsinfos, Wohnen, Infrastruktur, Northern Rivers',
  },
] as const;

// Etappen "Von Essen nach Byron Bay" - Texte 1:1 von live.
// Status aktualisiert Stand 24.07.2026 (CEO-Freigabe im Chat; Fakten:
// Abflug 23.06. + Ankunft 25.06. laut Angekommen-Artikel/CONTEXT,
// Familie folgt 26.07. = aktuelle Etappe).
const etappen = [
  { datum: 'Dez 2025', label: 'Restaurant geschlossen', status: 'done' },
  {
    datum: 'Feb 2026',
    label: 'PTE & Skill Assessment bestanden',
    status: 'done',
  },
  { datum: 'April 2026', label: 'Vorbereitung & Abbau', status: 'done' },
  { datum: '23. Juni 2026', label: 'Abflug', status: 'done' },
  { datum: '26. Juli 2026', label: 'Familie folgt', status: 'current' },
];
---

<BaseLayout
  title="Wildgewachsen – Auswandern nach Australien mit Familie"
  description="Wildgewachsen – Eine deutsche Familie wandert nach Australien aus. Unsere Reise, unsere Erfahrungen, unser Abenteuer nach Byron Bay."
  lang="de"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/videos/hero-loop-poster.jpg" fetchpriority="high" />
    <link rel="canonical" href="https://wildgewachsen-australien.de/" />
    <link rel="alternate" hreflang="de" href="https://wildgewachsen-australien.de/" />
    <link rel="alternate" hreflang="en" href="https://wildgewachsen-australien.de/en/" />
    <link rel="alternate" hreflang="x-default" href="https://wildgewachsen-australien.de/" />
    <!-- Open Graph -->
    <meta property="og:title" content="Wildgewachsen – Auswandern nach Australien mit Familie" />
    <meta property="og:description" content="Wildgewachsen – Eine deutsche Familie wandert nach Australien aus. Unsere Reise, unsere Erfahrungen, unser Abenteuer nach Byron Bay." />
    <meta property="og:image" content="https://wildgewachsen-australien.de/assets/images/hero-family.jpg" />
    <meta property="og:url" content="https://wildgewachsen-australien.de/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:locale:alternate" content="en_GB" />
    <meta property="og:site_name" content="Wildgewachsen" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Wildgewachsen – Auswandern nach Australien mit Familie" />
    <meta name="twitter:description" content="Wildgewachsen – Eine deutsche Familie wandert nach Australien aus. Unsere Reise, unsere Erfahrungen, unser Abenteuer nach Byron Bay." />
    <meta name="twitter:image" content="https://wildgewachsen-australien.de/assets/images/hero-family.jpg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png" />
    <!-- Klaro Consent, 1:1 wie live (defer-Reihenfolge: Config vor Klaro) -->
    <link rel="stylesheet" href="/css/klaro.css" />
    <script is:inline defer src="/js/klaro-config.js"></script>
    <script is:inline defer data-config="klaroConfig" src="/js/klaro.js"></script>
  </Fragment>

  {/* ===== Hero: Video-Buehne, EIN Terrakotta-Akzent = Haupt-CTA ===== */}
  <VideoHero
    src="/assets/videos/hero-loop.mp4"
    poster="/assets/videos/hero-loop-poster.jpg"
    lang="de"
  >
    <p class="eyebrow">Echtzeit-Dokumentation</p>
    <h1 class="hero-titel">Wir wandern mit zwei Kindern nach Australien aus.</h1>
    <p>
      Wir dokumentieren unseren Umzug von Deutschland nach Byron Bay in Echtzeit.
      Vier Menschen, zwei Kinder, ein Plan. Keine Beschönigung, nur ehrliche
      Antworten auf echte Fragen.
    </p>
    <p class="hero-aktionen">
      <a class="btn btn--primary" href="#newsletter">Unsere Reise mitverfolgen</a>
      <a class="btn btn--licht" href="/ueber-uns">Unsere Geschichte</a>
    </p>
  </VideoHero>

  {/* ===== Trust-Leiste: Gepaeckband-Streifen, kein Akzent ===== */}
  <div class="trust">
    <ul class="container trust__liste" role="list">
      <li class="trust__item">Echtzeit-Doku</li>
      <li class="trust__item">Abflug: 23. Juni 2026</li>
      <li class="trust__item">Byron Bay, NSW</li>
      <li class="trust__item">Zwei Kinder (2 &amp; 6)</li>
    </ul>
  </div>

  {/* ===== Ueber-uns-Teaser: Foto + Text, Akzent = CTA-Button ===== */}
  <section class="section">
    <div class="container ueber-teaser">
      <figure class="ueber-teaser__foto">
        <img src="/assets/images/family-about.jpg" alt="Unsere Familie" loading="lazy" />
      </figure>
      <div class="ueber-teaser__text">
        <p class="eyebrow">Wer wir sind</p>
        <h2>Koch, Innenarchitektin, zwei Kinder und ein Plan.</h2>
        <p>
          Sieben Jahre eigenes Restaurant, zwei Jahre Gemüseanbau, und dann die
          Entscheidung die alles verändert. Wir packen unser Leben in Essen
          zusammen und fangen in Australien neu an. Hier erzählen wir warum –
          und wie.
        </p>
        <p><a class="btn btn--primary" href="/ueber-uns">Mehr über uns</a></p>
      </div>
    </div>
  </section>

  {/* ===== Neueste Artikel: Postkarten-Deck (Akzent = Pfeil/Hover im
       WeiterlesenPfade-Bauteil) ===== */}
  <div class="container">
    <WeiterlesenPfade
      eyebrow="Aus dem Blog"
      ueberschrift="Neueste Artikel"
      artikel={neuesteArtikel}
    />
    <p class="text-mitte artikel-mehr">
      <a class="btn btn--umriss" href="/blog">Alle Artikel lesen</a>
    </p>
  </div>

  {/* ===== Tief eintauchen (Hub-Pillars): Postkarten mit Bild,
       Akzent = Pfeil/Hover-Titel ===== */}
  <section class="section" aria-labelledby="hubs-heading">
    <div class="container">
      <header class="sektion-kopf">
        <p class="eyebrow">Tief eintauchen</p>
        <h2 id="hubs-heading">Unsere Wegweiser</h2>
        <p class="sektion-kopf__intro">
          Die großen Sammelartikel zur Auswanderung — alles, was du an einem Ort
          brauchst. Wir aktualisieren sie quartalsweise.
        </p>
      </header>
      <ul class="wegweiser__grid" role="list">
        {
          wegweiser.map((w) => (
            <li class="card wegweiser__karte">
              <figure class="wegweiser__bild">
                <img src={w.bild} alt="" loading="lazy" />
                <p class="wegweiser__kategorie">{w.kategorie}</p>
              </figure>
              <h3 class="wegweiser__titel">
                <a class="wegweiser__link" href={w.href}>
                  {w.titel}
                </a>
                <span class="wegweiser__pfeil" aria-hidden="true">
                  &rarr;
                </span>
              </h3>
              <p class="wegweiser__meta">{w.meta}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ===== Themen: Etiketten-Raster, Akzent = Hover-Titel ===== */}
  <section class="section themen texture-grid">
    <div class="container">
      <header class="sektion-kopf">
        <p class="eyebrow">Was dich hier erwartet</p>
        <h2>Unsere Themen</h2>
      </header>
      <ul class="themen__grid" role="list">
        {
          themen.map((t) => (
            <li class="card themen__karte">
              <p class="themen__icon" aria-hidden="true">
                <HandIcon name={t.icon} />
              </p>
              <h3 class="themen__name">
                <a class="themen__link" href={t.href}>
                  {t.name}
                </a>
              </h3>
              <p class="themen__desc">{t.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ===== Reise-Etappen: Route wie im Reisetagebuch,
       Akzent = aktueller Etappen-Punkt ===== */}
  <section class="section" aria-labelledby="reise-heading">
    <div class="container">
      <header class="sektion-kopf">
        <p class="eyebrow">Unser Weg</p>
        <h2 id="reise-heading">Von Essen nach Byron Bay</h2>
      </header>
      <ol class="reise__liste" role="list">
        {
          etappen.map((e) => (
            <li class:list={['reise__etappe', `reise__etappe--${e.status}`]}>
              <span class="reise__punkt" aria-hidden="true" />
              <span class="reise__datum">{e.datum}</span>
              <span class="reise__label">{e.label}</span>
            </li>
          ))
        }
      </ol>
      <p class="text-mitte">
        <a class="btn btn--umriss" href="/unsere-reise">Die ganze Reise sehen</a>
      </p>
    </div>
  </section>

  {/* ===== Newsletter: Postkarte, Akzent = Abonnieren-Button ===== */}
  <section class="section" id="newsletter">
    <div class="container">
      <div class="card texture-grid newsletter">
        {/* Briefmarke + Poststempel: rein dekorativ, Sage (der eine
            Terrakotta-Akzent der Sektion bleibt der Abonnieren-Button) */}
        <div class="newsletter__marke" aria-hidden="true">
          <svg class="newsletter__briefmarke" viewBox="0 0 44 52" xmlns="http://www.w3.org/2000/svg">
            <rect x="3" y="3" width="38" height="46" rx="2" fill="var(--surface)" stroke="var(--sage)" stroke-width="1.5" stroke-dasharray="0.5 5" stroke-linecap="round" />
            <rect x="8" y="8" width="28" height="36" fill="none" stroke="var(--sage)" stroke-width="1" />
            <path d="M12 26 C 15 23.6, 18 23.5, 21 25.6 C 24 27.7, 27 27.8, 32 25.7 M12 32 C 15 29.6, 18 29.5, 21 31.6 C 24 33.7, 27 33.8, 32 31.7" fill="none" stroke="var(--sage)" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          <svg class="newsletter__poststempel" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="var(--ink-soft)" stroke-linecap="round">
            <circle cx="30" cy="30" r="24" stroke-width="1.4" stroke-dasharray="2.5 3.5" />
            <path d="M8 44 C 20 40, 40 40, 54 43 M10 50 C 22 46, 40 46, 52 49" stroke-width="1.2" />
          </svg>
        </div>
        <p class="eyebrow">Dabei sein</p>
        <h2>Unsere Reise mitverfolgen</h2>
        <p class="newsletter__text">
          Wir schicken Updates wenn es weitergeht. Kein Spam, keine Werbung –
          nur echte Neuigkeiten von unserer Auswanderung.
        </p>
        <form class="newsletter__form" data-newsletter>
          <label class="visually-hidden" for="newsletter-email">
            Deine E-Mail-Adresse
          </label>
          <input
            id="newsletter-email"
            class="newsletter__input"
            type="email"
            placeholder="Deine E-Mail-Adresse"
            required
          />
          <button type="submit" class="btn btn--primary">Abonnieren</button>
        </form>
        <p class="newsletter__hinweis">
          Du kannst dich jederzeit abmelden. Versprochen.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Buttons (nur Tokens, Mono-Etiketten-Optik) --------------------- */
  .btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text--1);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-s);
    border: 1px solid transparent;
    cursor: pointer;
  }

  .btn--primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }

  .btn--primary:hover {
    background: var(--accent-strong);
    border-color: var(--accent-strong);
  }

  .btn--umriss {
    background: transparent;
    border-color: var(--ink-soft);
    color: var(--ink);
  }

  .btn--umriss:hover {
    border-color: var(--ink);
  }

  /* Heller Umriss-Button fuer die dunkle Hero-Flaeche (Panel = Ink) */
  .btn--licht {
    background: transparent;
    border-color: var(--bg);
    color: var(--bg);
  }

  .btn--licht:hover {
    background: color-mix(in srgb, var(--bg) 14%, transparent);
  }

  .text-mitte {
    text-align: center;
  }

  /* --- Hero-Overlay --------------------------------------------------- */
  .hero-titel {
    font-size: var(--text-3);
  }

  .hero-aktionen {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-4);
  }

  /* --- Trust-Leiste (Gepaeckband) ------------------------------------- */
  .trust {
    border-block: 1px solid var(--line);
    background: var(--surface);
  }

  .trust__liste {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-6);
    list-style: none;
    padding-block: var(--space-3);
  }

  .trust__item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text--1);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
  }

  .trust__item::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sage);
  }

  /* --- Ueber-uns-Teaser ------------------------------------------------ */
  .ueber-teaser {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-7);
    align-items: center;
  }

  /* Foto wie ins Tagebuch geklebt: Creme-Rahmen, leicht verdreht */
  .ueber-teaser__foto {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    box-shadow: var(--shadow-card);
    padding: var(--space-3);
    rotate: -1deg;
  }

  .ueber-teaser__foto img {
    border-radius: var(--radius-s);
    width: 100%;
    object-fit: cover;
  }

  .ueber-teaser__text > * + * {
    margin-block-start: var(--space-3);
  }

  @media (max-width: 800px) {
    .ueber-teaser {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }

  /* --- Neueste Artikel: Button haengt unter dem Karten-Deck ----------- */
  .artikel-mehr {
    margin-block-start: calc(-1 * var(--space-5));
    padding-block-end: var(--space-6);
  }

  /* --- Sektions-Koepfe ------------------------------------------------- */
  .sektion-kopf {
    display: grid;
    gap: var(--space-2);
    margin-block-end: var(--space-5);
  }

  .sektion-kopf__intro {
    color: var(--ink-soft);
    max-inline-size: 55ch;
  }

  /* --- Wegweiser (Hub-Pillars): Postkarten mit Bild -------------------- */
  .wegweiser__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: var(--space-5);
    list-style: none;
    padding: 0;
  }

  .wegweiser__karte {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition:
      rotate 180ms ease,
      box-shadow 180ms ease;
  }

  .wegweiser__karte:nth-child(odd) {
    rotate: -0.5deg;
  }

  .wegweiser__karte:nth-child(even) {
    rotate: 0.5deg;
  }

  .wegweiser__karte:hover,
  .wegweiser__karte:focus-within {
    rotate: 0deg;
    box-shadow: var(--shadow-float);
  }

  .wegweiser__bild {
    position: relative;
    margin: calc(-1 * var(--space-2)) calc(-1 * var(--space-2)) 0;
  }

  .wegweiser__bild img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-m);
  }

  .wegweiser__kategorie,
  .wegweiser__meta {
    font-family: var(--font-mono);
    font-size: var(--text--1);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
  }

  /* Kategorie als schief aufgeklebtes Etikett auf dem Postkarten-Foto */
  .wegweiser__kategorie {
    position: absolute;
    left: var(--space-3);
    bottom: calc(-1 * var(--space-2));
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    padding: var(--space-1) var(--space-3);
    box-shadow: var(--shadow-card);
    rotate: -2deg;
  }

  .wegweiser__meta {
    margin-block-start: auto;
  }

  .wegweiser__titel {
    font-size: var(--text-1);
  }

  .wegweiser__link {
    color: var(--ink);
    text-decoration: none;
  }

  /* Ganze Karte klickbar (stretched link) */
  .wegweiser__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .wegweiser__karte:hover .wegweiser__link,
  .wegweiser__karte:focus-within .wegweiser__link {
    color: var(--accent-strong);
  }

  .wegweiser__pfeil {
    color: var(--accent-strong);
    margin-inline-start: var(--space-1);
  }

  /* --- Themen: Etiketten-Raster ---------------------------------------- */
  .themen__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: var(--space-4);
    list-style: none;
    padding: 0;
  }

  .themen__karte {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition:
      rotate 180ms ease,
      box-shadow 180ms ease;
  }

  /* Etiketten-Gefuehl: minimal schief aufgeklebt, richtet sich beim Hover */
  .themen__karte:nth-child(odd) {
    rotate: -0.4deg;
  }

  .themen__karte:nth-child(even) {
    rotate: 0.4deg;
  }

  .themen__karte:hover,
  .themen__karte:focus-within {
    rotate: 0deg;
    box-shadow: var(--shadow-float);
  }

  /* Icon als Stempel-Abdruck: gestrichelter Kreis, Sage, leicht verkantet */
  .themen__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    color: var(--sage-text);
    background: var(--bg);
    border: 1px dashed var(--sage);
    border-radius: 50%;
    rotate: -3deg;
  }

  .themen__karte:nth-child(even) .themen__icon {
    rotate: 2.5deg;
  }

  .themen__name {
    font-size: var(--text-1);
  }

