---
// Impressum & Datenschutz im neuen Look "Sonnengetrocknete Erde".
// Rechtstexte 1:1 WORTGLEICH aus website/impressum.html (Live-Stand) portiert,
// nichts gekuerzt. Anker #datenschutz + #bildrechte unveraendert erhalten.
// Head-Werte (robots noindex, canonical, OG/Twitter, Favicons) exakt wie live;
// live hat KEINE hreflang-Tags auf dieser Seite, daher hier auch nicht.
// Klaro-Consent 1:1 wie live (wird vom Klaro-Widerrufs-Link in Abschnitt 9
// gebraucht), app.js bewusst NICHT portiert.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Impressum & Datenschutz – Wildgewachsen"
  description="Impressum von wildgewachsen-australien.de"
  lang="de"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://wildgewachsen-australien.de/impressum" />
    <!-- Open Graph -->
    <meta property="og:title" content="Impressum & Datenschutz – Wildgewachsen" />
    <meta property="og:description" content="Impressum von wildgewachsen-australien.de" />
    <meta property="og:image" content="https://wildgewachsen-australien.de/assets/images/hero-family.jpg" />
    <meta property="og:url" content="https://wildgewachsen-australien.de/impressum" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Impressum & Datenschutz – Wildgewachsen" />
    <meta name="twitter:description" content="Impressum von wildgewachsen-australien.de" />
    <meta name="twitter:image" content="https://wildgewachsen-australien.de/assets/images/hero-family.jpg" />
