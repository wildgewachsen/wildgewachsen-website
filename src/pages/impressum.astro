<style>
  /* --- Auftakt: kompakter Seitenkopf ---------------------------------- */
  .auftakt {
    border-block-end: 1px solid var(--line);
    padding-block: var(--space-7);
  }

  /* --- Rechtstexte ------------------------------------------------------ */
  .legal h2 {
    /* Anker (#datenschutz) landen nicht unterm Header-Rand */
    scroll-margin-top: var(--space-7);
  }

  .legal h3 {
    scroll-margin-top: var(--space-7);
  }

  .legal code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    padding: 0 var(--space-1);
  }

  /* --- Tabellen: Etiketten-Optik mit Tokens, horizontal scrollbar ------ */
  .tabelle-scroll {
    overflow-x: auto;
  }

  .legal-tabelle {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text--1);
    line-height: 1.5;
  }

  .legal-tabelle th,
  .legal-tabelle td {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .legal-tabelle thead tr {
    background: var(--surface);
  }

  .legal-tabelle th {
    font-family: var(--font-mono);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }
</style>
