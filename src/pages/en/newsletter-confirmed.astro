---
// Thank-you page after newsletter confirmation (double opt-in), English.
// Replaces Kit's default "Subscription confirmed!" page, which is English
// only and additionally advertises Kit itself.
//
// SET IN KIT: form "wildgewachsen EN" (ID 9795996)
// -> Settings -> Confirmation email -> "After confirming redirect to" -> URL.
//
// This page carries the honest language note (spec section 6): the newsletter
// currently goes out in German. It is the last point where an English
// subscriber learns that before waiting.
//
// noindex: thank-you pages do not belong in the index or the sitemap.
import BaseLayout from '../../layouts/BaseLayout.astro';

const einstieg = [
  {
    titel: 'Why we left in the first place',
    text: 'From a vegetable garden to the decision to leave everything behind.',
    href: '/en/from-vegetable-garden-to-australia-family-move',
    label: 'Read the story',
  },
  {
    titel: 'What it cost',
    text: 'What the move cost for four people in the end, item by item.',
    href: '/en/cost-of-moving-to-australia-family-guide',
    label: 'See the numbers',
  },
  {
    titel: 'The visa everything depends on',
    text: 'How the 186 works and why it became our route.',
    href: '/en/186-visa-australia-family-guide',
    label: 'Read the guide',
  },
];
---

<BaseLayout
  title="Subscription confirmed – Wildgewachsen"
  description="Your newsletter subscription is confirmed."
  lang="en"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="https://wildgewachsen-australien.de/en/newsletter-confirmed" />
    <link rel="alternate" hreflang="de" href="https://wildgewachsen-australien.de/newsletter-bestaetigt" />
    <link rel="alternate" hreflang="en" href="https://wildgewachsen-australien.de/en/newsletter-confirmed" />
    <link rel="alternate" hreflang="x-default" href="https://wildgewachsen-australien.de/newsletter-bestaetigt" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png" />
    <link rel="stylesheet" href="/css/klaro.css" />
    <script is:inline defer src="/js/klaro-config.js"></script>
    <script is:inline defer data-config="klaroConfig" src="/js/klaro.js"></script>
  </Fragment>

  <section class="section">
    <div class="container danke">
      <header class="sektion-kopf">
        <p class="eyebrow">All set</p>
        <h1>You are in</h1>
        <p class="danke__text">
          Your subscription is confirmed. We write every second Sunday about what
          is actually happening. If you do not like it, one click at the bottom of
          any email takes you back out.
        </p>
      </header>

      {/* Ehrlicher Sprach-Hinweis, Spec Abschnitt 6. Letzte Stelle, an der eine
          englische Anmeldung erfaehrt, dass der Newsletter deutsch erscheint. */}
      <p class="danke__hinweis">
        One honest note: the newsletter currently goes out in German. We are
        keeping track of everyone who signs up in English, and you will hear from
        us as soon as there is an English edition. Until then, the English part of
        the blog is here.
      </p>

      <p class="danke__zwischentitel">Where to start</p>

      <ul class="danke__liste">
        {
          einstieg.map((e) => (
            <li class="danke__eintrag">
              <p class="danke__titel">{e.titel}</p>
              <p class="danke__teaser">{e.text}</p>
              <a class="danke__link" href={e.href}>
                {e.label}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="danke__fuss">
        If you have a question, just reply to any of our emails. It reaches us.
        Or <a href="/en/contact">write to us here</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .danke {
    max-inline-size: 46rem;
  }

  /* Linksbuendig auf derselben Kante wie die Artikel darunter. */
  .danke__text {
    color: var(--ink-soft);
    max-inline-size: 46ch;
    margin-block: var(--space-6) var(--space-6);
  }

  .danke__hinweis {
    margin-block-end: var(--space-7);
    padding: var(--space-3) var(--space-4);
    border: 1px dashed var(--line);
    border-radius: var(--radius-s);
    color: var(--ink-soft);
    font-size: var(--text--1);
  }

  .danke__zwischentitel {
    font-family: var(--font-mono);
    font-size: var(--text--1);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
    margin-block: 0 var(--space-5);
    padding-block-end: var(--space-2);
    border-bottom: 1px dashed var(--line);
  }

  .danke__liste {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-5);
  }

  /* Eukalyptus-Kante wie in der Willkommensmail */
  .danke__eintrag {
    border-left: 2px solid var(--sage);
    padding-left: var(--space-3);
  }

  .danke__titel {
    font-family: var(--font-display);
    font-size: var(--text-1);
    line-height: 1.3;
    margin: 0 0 var(--space-1) 0;
  }

  .danke__teaser {
    color: var(--ink-soft);
    margin: 0 0 var(--space-2) 0;
  }

  .danke__link {
    color: var(--accent-strong);
  }

  .danke__fuss {
    margin-block-start: var(--space-6);
    color: var(--ink-soft);
  }
</style>
