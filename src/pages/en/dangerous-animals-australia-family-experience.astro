    .artikel-figur--gross { margin-inline: calc(var(--space-3) * -1); }
    .artikel-figur--alt { border-style: dashed; }
    .artikel-figur--alt figcaption {
      font-family: var(--font-body);
      font-size: var(--text--1);
      color: #695a48;
    }
    .artikel-figur--alt figcaption strong { color: #a63e22; }

    .info-box {
      background: var(--surface);
      border: 1px solid var(--line);
      border-inline-start: 3px solid var(--accent);
      border-radius: var(--radius-s);
      padding: var(--space-4);
      margin-block: var(--space-5);
    }
    .info-box__titel {
      font-family: var(--font-mono);
      font-size: var(--text--1);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-soft);
      margin-block-end: var(--space-2);
    }
    .info-box ul { margin: 0; padding-inline-start: 1.1rem; }
    .info-box li { margin-block: var(--space-1); }

    /* Sightings pass: fixed hex values on purpose, behaves like a sheet of
       paper glued in that does not darken with the rest of the page. */
    .pass {
      background: #fbf7ee;
      border: 1px solid #ddd3bc;
      border-radius: var(--radius-s);
      padding: var(--space-4);
      margin-block: var(--space-5);
    }
    .pass__kopf {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-block-end: 2px solid #33291f;
      padding-block-end: var(--space-2);
      margin-block-end: var(--space-3);
    }
    .pass__titel { font-family: var(--font-display); font-size: var(--text-1); color: #33291f; }
    .pass__zaehler { font-family: var(--font-mono); font-size: var(--text-2); color: #a63e22; }
    .pass__von { font-size: var(--text-0); color: #695a48; }
    .pass__gitter {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
      gap: var(--space-3);
    }
    .stempel {
      aspect-ratio: 1;
      border-radius: 50%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 4px;
      gap: 2px;
    }
    .stempel--voll { border: 1.5px solid #b5482a; }
    .stempel--voll:nth-child(3n) { transform: rotate(-6deg); }
    .stempel--voll:nth-child(3n + 1) { transform: rotate(4deg); }
    .stempel--leer { border: 1.5px dashed #ddd3bc; }
    .stempel__name {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      line-height: 1.15;
      color: #33291f;
    }
    .stempel--leer .stempel__name { color: #a1937c; }
    .stempel__datum { font-family: var(--font-mono); font-size: 0.58rem; color: #a63e22; }
    .stempel__offen { font-family: var(--font-mono); font-size: 0.58rem; color: #c4b8a0; }
    .pass__fuss {
      font-family: var(--font-hand);
      color: #a63e22;
      font-size: var(--text-1);
      margin-block-start: var(--space-3);
      margin-block-end: 0;
    }

    .zeichnung-platz {
      border: 1.5px dashed #c4b8a0;
      border-radius: var(--radius-s);
      background: #fbf7ee;
      min-block-size: 150px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: var(--space-3);
      text-align: center;
    }
    .zeichnung-platz__label {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #a1937c;
    }
    .zeichnung-platz__name {
      font-family: var(--font-hand);
      font-size: var(--text-1);
      color: #a63e22;
    }
    .zeichnung-platz__hinweis {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      color: #695a48;
      max-inline-size: 30ch;
      line-height: 1.5;
    }
    .zeichnung-platz--breit { min-block-size: 190px; margin-block: var(--space-4); }
    .zeichnung-platz--ernst { background: #ebe0c8; border-color: #b5a88c; margin-block: var(--space-4); }
    .zeichnung-platz--durchgestrichen { position: relative; overflow: hidden; }
    .zeichnung-platz--durchgestrichen::after {
      content: '';
      position: absolute;
      inset-inline: -10%;
      inset-block-start: 50%;
      block-size: 2px;
      background: #b5482a;
      transform: rotate(-14deg);
    }
    .zeichnung-reihe {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-3);
      margin-block: var(--space-5);
    }
    .zeichnung-reihe figcaption {
      grid-column: 1 / -1;
      font-family: var(--font-mono);
      font-size: var(--text--1);
      color: var(--ink-soft);
      text-align: center;
    }
    @media (max-width: 560px) { .zeichnung-reihe { grid-template-columns: 1fr; } }

    .chart-figur {
      background: #fbf7ee;
      border: 1px solid #ddd3bc;
      border-radius: var(--radius-s);
      padding: var(--space-4);
      margin-block: var(--space-5);
    }
    .chart-figur svg { inline-size: 100%; block-size: auto; }
    .chart-figur figcaption {
      font-family: var(--font-mono);
      font-size: var(--text--1);
      color: #695a48;
      margin-block-start: var(--space-2);
    }

    .ernst {
      background: #ebe0c8;
      border-block: 1px solid #c4b8a0;
      padding: var(--space-5) var(--space-4);
      margin-block: var(--space-6);
      margin-inline: calc(var(--space-4) * -1);
      color: #33291f;
    }
    .ernst h2, .ernst h3 { color: #33291f; }
    .ernst p { color: #3d3227; }
    .ernst a { color: #a63e22; }

    .zahlen-block { margin-block: var(--space-4); }
    .zahlen-block__zeile {
      display: flex;
      gap: var(--space-3);
      align-items: baseline;
      padding-block: var(--space-2);
      border-block-end: 1px dotted #c4b8a0;
    }
    .zahlen-block__zahl {
      font-family: var(--font-display);
      font-size: var(--text-2);
      color: #a63e22;
      min-inline-size: 3.5ch;
      flex: none;
    }
    .zahlen-block__text { font-size: var(--text-0); line-height: 1.6; }

    .tafel {
      background: #fbf7ee;
      border: 1.5px solid #33291f;
      padding: var(--space-4);
      margin-block: var(--space-5);
    }
    .tafel__kopf {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #695a48;
      margin-block-end: var(--space-3);
    }
    .tafel svg { inline-size: 100%; block-size: auto; }
    .tafel figcaption {
      font-family: var(--font-mono);
      font-size: var(--text--1);
      color: #695a48;
      margin-block-start: var(--space-2);
      line-height: 1.5;
    }

    .hinweis-medizin {
      background: #fbf7ee;
      border-inline-start: 3px solid #b5482a;
      padding: var(--space-3) var(--space-4);
      margin-block-start: var(--space-5);
    }
    .hinweis-medizin p { margin: 0; font-size: var(--text--1); line-height: 1.65; }

    .nichtda {
      border: 1.5px dashed var(--accent);
      border-radius: var(--radius-s);
      padding: var(--space-4);
      margin-block: var(--space-5);
    }
    .nichtda > figcaption {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent-strong);
      margin-block-end: var(--space-3);
    }
    .nichtda__reihe { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
    @media (max-width: 560px) { .nichtda__reihe { grid-template-columns: 1fr; } }
    .nichtda__text { margin-block-start: var(--space-3); margin-block-end: 0; }

    .liste {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius-s);
      padding: var(--space-4);
      margin-block: var(--space-5);
    }
    .liste__kopf {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-3);
      flex-wrap: wrap;
      border-block-end: 2px solid var(--ink);
      padding-block-end: var(--space-2);
      margin-block-end: var(--space-3);
    }
    .liste__zaehler { font-family: var(--font-mono); font-size: var(--text-0); color: var(--accent-strong); }
    .liste__druck {
      font-family: var(--font-mono);
      font-size: var(--text--1);
      background: transparent;
      border: 1px solid var(--accent-strong);
      color: var(--accent-strong);
      border-radius: var(--radius-s);
      padding: 6px 14px;
      cursor: pointer;
    }
    .liste__druck:hover { background: var(--accent-strong); color: var(--accent-contrast); }
    .liste__ast { margin-block-end: var(--space-3); }
    .liste__ast > summary {
      font-family: var(--font-display);
      font-size: var(--text-1);
      cursor: pointer;
      padding-block: var(--space-1);
    }
    .liste__hinweis {
      font-family: var(--font-hand);
      color: var(--accent-strong);
      font-size: var(--text-1);
      margin-block: var(--space-1) var(--space-2);
    }
    .liste__eintraege { list-style: none; margin: 0; padding: 0; }
    .liste__eintraege li { border-block-end: 1px dotted var(--line); }
    .liste__eintraege label {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      padding-block: var(--space-2);
      cursor: pointer;
    }
    .liste__eintraege input { inline-size: 17px; block-size: 17px; accent-color: var(--accent-strong); flex: none; }
    .liste__name { font-size: var(--text-0); }
    .liste__saison {
      margin-inline-start: auto;
      font-family: var(--font-mono);
      font-size: var(--text--1);
      color: var(--accent-strong);
    }
    .liste__fuss { font-size: var(--text--1); color: var(--ink-soft); margin-block-end: 0; }

    .trust-box, .update-log {
      font-size: var(--text--1);
      color: var(--ink-soft);
      border-block-start: 1px solid var(--line);
      padding-block-start: var(--space-3);
      margin-block-start: var(--space-5);
    }

    @media print {
      body * { visibility: hidden; }
      .liste, .liste * { visibility: visible; }
      .liste {
        position: absolute;
        inset-block-start: 0;
        inset-inline-start: 0;
        inline-size: 100%;
        border: none;
        padding: 0;
      }
      .liste__druck, .liste__fuss { display: none; }
      .liste__ast > summary { break-after: avoid; }
      .liste__eintraege input { appearance: none; border: 1.5px solid #33291f; }
    }
  </style>

  <script>
    // Reader checklist progress, stored locally in the browser only.
    const wurzel = document.querySelector('[data-liste]');
    if (wurzel) {
      const SCHLUESSEL = 'wg-animal-list-v1';
      const kaesten = wurzel.querySelectorAll('input[type="checkbox"]');
      const zaehler = wurzel.querySelector('[data-zaehler]');

      const lies = () => {
        try {
          return JSON.parse(localStorage.getItem(SCHLUESSEL) || '[]');
        } catch {
          return [];
        }
      };
      const schreib = (werte) => {
        try {
          localStorage.setItem(SCHLUESSEL, JSON.stringify(werte));
        } catch {
          /* Private mode or blocked storage: the list still works. */
        }
      };
      const aktualisiere = () => {
        const an = [...kaesten].filter((k) => k.checked);
        if (zaehler) zaehler.textContent = String(an.length);
        schreib(an.map((k) => k.dataset.tier));
      };

      const gespeichert = lies();
      kaesten.forEach((k) => {
        if (gespeichert.includes(k.dataset.tier)) k.checked = true;
        k.addEventListener('change', aktualisiere);
      });
      if (zaehler) zaehler.textContent = String([...kaesten].filter((k) => k.checked).length);

      wurzel.querySelector('[data-drucken]')?.addEventListener('click', () => window.print());
    }
  </script>
</ArtikelLayout>
