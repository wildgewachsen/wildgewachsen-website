  { name: 'Python',           ast: 'bush',   gesehen: '2026-09-03', saison: null,    zeichnung: true },
  { name: 'Goanna',           ast: 'bush',   gesehen: '2026-09-05', saison: null,    zeichnung: false },
  { name: 'Kangaroo',         ast: 'bush',   gesehen: null,         saison: null,    zeichnung: false },

  { name: 'Brush Turkey',     ast: 'garden', gesehen: '2026-06-25', saison: null,    zeichnung: true },
  { name: 'Kookaburra',       ast: 'garden', gesehen: '2026-06-28', saison: null,    zeichnung: true },
  { name: 'Huntsman',         ast: 'garden', gesehen: '2026-07-03', saison: null,    zeichnung: true },
  { name: 'Cockatoo',         ast: 'garden', gesehen: '2026-08-04', saison: null,    zeichnung: false },
  { name: 'Gecko',            ast: 'garden', gesehen: '2026-08-28', saison: null,    zeichnung: false },
  { name: 'Rainbow Lorikeet', ast: 'garden', gesehen: null,         saison: null,    zeichnung: false },
  { name: 'White Ibis',       ast: 'garden', gesehen: null,         saison: null,    zeichnung: false },

  { name: 'Flying Fox',       ast: 'night',  gesehen: '2026-06-26', saison: null,    zeichnung: true },
  { name: 'Cane Toad',        ast: 'night',  gesehen: '2026-08-25', saison: null,    zeichnung: false },
  { name: 'Possum',           ast: 'night',  gesehen: null,         saison: null,    zeichnung: false },
];

const aeste = [
  { id: 'water',  label: 'On the water',        hinweis: 'From the headland or the beach. Binoculars help more than any app.' },
  { id: 'bush',   label: 'In forest and bush',  hinweis: 'Early morning and at dusk. Walk slowly, look up often.' },
  { id: 'garden', label: 'Garden and house',    hinweis: 'Most encounters happen here, not out in the wild.' },
  { id: 'night',  label: 'At night',            hinweis: 'Ears before eyes. You hear most of it long before you see it.' },
];

const gesehenAnzahl = tiere.filter((t) => t.gesehen).length;
const gesamt = tiere.length;

const tocEintraege = [
  { id: 'tally',        label: 'Our tally after three months' },
  { id: 'first-days',   label: 'The first encounters' },
  { id: 'whales',       label: 'Whales, and how to miss them' },
  { id: 'wallaby',      label: 'The wallaby we had to wait for' },
  { id: 'snakes',       label: 'Snakes: what the numbers say' },
  { id: 'rainforest',   label: 'Postscript: the rainforest' },
  { id: 'not-here',     label: 'What you will not find here' },
  { id: 'your-list',    label: 'Your list to take along' },
  { id: 'faq',          label: 'Frequently asked questions' },
];

const monate = ['J', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'];
---

<ArtikelLayout
  title="Dangerous animals in Australia: what actually crossed our path in three months"
  seoTitle="Dangerous animals in Australia: our experience with kids"
  description="Three months on the Australian east coast with two small children: 18 species seen, three snakes, no dangerous situation. What the snakebite data really says."
  lang="en"
  eyebrow="Everyday life in Australia"
  datum="17 September 2026"
  lesezeit="15 minutes"
>
  <Fragment slot="head">
    <link rel="canonical" href="https://wildgewachsen-australien.de/en/dangerous-animals-australia-family-experience" />
    <link rel="alternate" hreflang="de" href="https://wildgewachsen-australien.de/blog/gefaehrliche-tiere-australien-familie-erfahrung" />
    <link rel="alternate" hreflang="en" href="https://wildgewachsen-australien.de/en/dangerous-animals-australia-family-experience" />
    <link rel="alternate" hreflang="x-default" href="https://wildgewachsen-australien.de/blog/gefaehrliche-tiere-australien-familie-erfahrung" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Wildgewachsen" />
