// Same single data source as the German article, rendered twice:
// our tally at the top, the reader's checklist at the bottom.
// Evidence: video_katalog/catalog.json + video_katalog/transkripte/
const tiere = [
  { name: 'Dolphin',          ast: 'water',  gesehen: '2026-06-25', saison: null,    zeichnung: true },
  { name: 'Humpback Whale',   ast: 'water',  gesehen: '2026-07-03', saison: [5, 11], zeichnung: true },
  { name: 'Shark',            ast: 'water',  gesehen: '2026-07-04', saison: null,    zeichnung: true },
  { name: 'Pelican',          ast: 'water',  gesehen: '2026-07-03', saison: null,    zeichnung: false },
  { name: 'Sea Eagle',        ast: 'water',  gesehen: null,         saison: null,    zeichnung: false },
  { name: 'Sea Turtle',       ast: 'water',  gesehen: null,         saison: null,    zeichnung: false },

  { name: 'Koala',            ast: 'bush',   gesehen: '2026-07-04', saison: null,    zeichnung: true },
  { name: 'Wallaby',          ast: 'bush',   gesehen: '2026-07-20', saison: null,    zeichnung: true },
  { name: 'Echidna',          ast: 'bush',   gesehen: '2026-06-30', saison: null,    zeichnung: true },
