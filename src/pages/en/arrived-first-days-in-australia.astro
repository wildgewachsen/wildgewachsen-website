    border-top: 1px dashed var(--line);
  }

  .update-log__datum {
    flex: none;
    color: var(--ink-soft);
  }

  /* --- Autor-Box ------------------------------------------------- */
  .author-box {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
