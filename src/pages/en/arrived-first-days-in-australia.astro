<style>
  .artikel-bild {
    width: 100%;
    max-block-size: 75vh;
    object-fit: cover;
    border-radius: var(--radius-m);
  }

  /* --- Artikel-Fotos: eingeklebte Polaroids (Retro-Leitlinie) -----
     Hochformat-Fotos aus dem Live-Artikel (figure-portrait-left) als
     Polaroid mit Handschrift-Caption; Caveat = der EINE Terrakotta-
     Akzent der jeweiligen Sektion. */
  /* Linksbuendig an der Textkante statt zentriert: mittige Platzierung
     brach den Lesefluss der linksbuendigen Spalte (CEO-Feedback 24.07.) */
  .artikel-figur {
    max-inline-size: 420px;
    margin-inline: 0;
    margin-block: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    box-shadow: var(--shadow-card);
    padding: var(--space-3) var(--space-3) var(--space-4);
    rotate: -1deg;
  }

  .artikel-figur:nth-of-type(even) {
    rotate: 1deg;
  }

  /* Achterbahn-Unikat: eingeklebtes Papier-Chart, bleibt wie alle Charts
     immer hell (feste Papier-Farben statt Tokens, lesbar in beiden Modi) */
  .achterbahn {
    margin-block: var(--space-6);
    background: #fbf7ee;
    border: 1px solid #ddd3bc;
    border-radius: var(--radius-m);
    padding: var(--space-4);
    box-shadow: var(--shadow-card);
    rotate: 0.6deg;
  }

  .achterbahn__caption {
    font-family: var(--font-hand);
    font-size: var(--text-1);
    color: #a63e22;
    text-align: center;
    margin-block-start: var(--space-2);
  }

  /* Zahlen-Bento als ruhiges 2x2 in der Artikel-Spalte (statt auto-fit,
     das mit einer l-Kachel ragged wirkte) */
  .zahlen-bento :global(.bento__grid) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 640px) {
    .zahlen-bento :global(.bento__grid) {
      grid-template-columns: 1fr;
    }
  }

  .artikel-figur img {
    width: 100%;
    border-radius: var(--radius-s);
  }

  .artikel-figur figcaption {
    font-family: var(--font-hand);
    font-size: var(--text-1);
    line-height: 1.3;
    color: var(--accent-strong);
    margin-block-start: var(--space-2);
  }

  /* --- Inhaltsverzeichnis ---------------------------------------
     StickyToc erwartet ab 1100px eine Spalte vom Parent-Layout.
     Im Ein-Spalten-Artikel: bis 1439px als Aufklappbox im Fluss,
     ab 1440px als sticky Randspalte links neben der Lese-Spalte. */
  :global(.prose) {
    position: relative;
  }

  @media (min-width: 1100px) and (max-width: 1439.98px) {
    .toc-halter :global(.toc) {
      position: static;
    }

    .toc-halter :global(.toc__box--desktop) {
      display: none;
    }

    .toc-halter :global(.toc__box--mobile) {
      display: block;
    }
  }

  @media (min-width: 1440px) {
    .toc-halter {
      position: absolute;
      inset-block: 0;
      inset-inline-start: calc(-240px - var(--space-7));
      width: 240px;
      margin: 0;
    }
  }

  /* --- Info-Box (The short version) ------------------------------ */
  .info-box {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-card);
    padding: var(--space-5);
  }

  .info-box__titel {
    font-family: var(--font-mono);
    font-size: var(--text--1);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-soft);
    margin-block-end: var(--space-3);
  }

  .info-box p + p,
  .info-box ul {
    margin-block-start: var(--space-3);
  }

  .info-box ul {
    padding-inline-start: 1.4em;
  }

  .info-box li + li {
    margin-block-start: var(--space-2);
  }

  /* --- Trust Box ------------------------------------------------- */
  .trust-box {
    background: var(--surface);
    border: 1px dashed var(--line);
    border-radius: var(--radius-s);
    padding: var(--space-5);
    font-size: var(--text--1);
    color: var(--ink-soft);
  }

  .trust-box p + p {
    margin-block-start: var(--space-3);
  }

  /* --- Update-Log ------------------------------------------------ */
  .update-log {
    font-family: var(--font-mono);
    font-size: var(--text--1);
  }

  .update-log__titel {
    text-transform: uppercase;
