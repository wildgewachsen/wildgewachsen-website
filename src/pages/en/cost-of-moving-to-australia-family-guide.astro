<style>
  .artikel-bild {
    width: 100%;
    border-radius: var(--radius-m);
  }

  /* --- Inhaltsverzeichnis ---------------------------------------
     StickyToc erwartet ab 1100px eine Spalte vom Parent-Layout.
     Im Ein-Spalten-Artikel: bis 1439px als Aufklappbox im Fluss,
     ab 1440px als sticky Randspalte links neben der Lese-Spalte. */
  :global(.prose) {
    position: relative;
  }

  @media (min-width: 1100px) and (max-width: 1439.98px) {
    .toc-halter :global(.toc) {
      position: static;
    }

    .toc-halter :global(.toc__box--desktop) {
      display: none;
    }

    .toc-halter :global(.toc__box--mobile) {
      display: block;
    }
  }

  @media (min-width: 1440px) {
    .toc-halter {
      position: absolute;
      inset-block: 0;
      inset-inline-start: calc(-240px - var(--space-7));
      width: 240px;
      margin: 0;
    }
  }

  /* --- Info-Boxen (Key takeaways, Status, Advertising note) ------ */
  .info-box {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-card);
    padding: var(--space-5);
  }

  .info-box__titel {
    font-family: var(--font-mono);
    font-size: var(--text--1);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-soft);
    margin-block-end: var(--space-3);
  }

  .info-box p + p,
  .info-box ul {
    margin-block-start: var(--space-3);
  }

  .info-box ul {
    padding-inline-start: 1.4em;
  }

  .info-box li + li {
    margin-block-start: var(--space-2);
  }

  /* --- Charts ---------------------------------------------------- */
  /* Charts als "gedrucktes Papier": bewusst IMMER hell (feste Hexwerte statt
     Tokens), damit die hell-fixierten SVG-Farben auch im Dark Mode lesbar
     bleiben. Passt zum Retro-Look: ein eingeklebtes Chart im Reisetagebuch. */
  .chart-figur {
    margin-block: var(--space-6);
    background: #fbf7ee;
    border: 1px solid #ddd3bc;
    border-radius: var(--radius-m);
    padding: var(--space-4);
    overflow-x: auto;
    box-shadow: var(--shadow-card);
  }

  .chart-figur svg {
    margin-inline: auto;
  }

  /* --- Kosten-Tabellen (in den Aufklapp-Boxen) ------------------- */
  .kosten-tabelle {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text--1);
  }

  .kosten-tabelle th {
    text-align: left;
    font-family: var(--font-mono);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
    padding: var(--space-2);
    border-bottom: 1px solid var(--line);
  }

  .kosten-tabelle td {
    padding: var(--space-2);
    border-bottom: 1px dashed var(--line);
    vertical-align: top;
  }

  .kosten-tabelle tbody tr:last-child td {
    border-bottom: none;
  }

  /* --- Trust Box ------------------------------------------------- */
  .trust-box {
    background: var(--surface);
    border: 1px dashed var(--line);
    border-radius: var(--radius-s);
    padding: var(--space-5);
    font-size: var(--text--1);
    color: var(--ink-soft);
  }

  .trust-box p + p {
    margin-block-start: var(--space-3);
  }

  /* --- Update-Log ------------------------------------------------ */
  .update-log {
    font-family: var(--font-mono);
    font-size: var(--text--1);
  }

  .update-log__titel {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-soft);
    margin-block-end: var(--space-2);
  }

  .update-log__eintrag {
    display: flex;
    gap: var(--space-4);
    padding-block: var(--space-2);
    border-top: 1px dashed var(--line);
  }

  .update-log__datum {
    flex: none;
    color: var(--ink-soft);
  }

  /* --- Autor-Box ------------------------------------------------- */
  .author-box {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-card);
    padding: var(--space-5);
  }

  .author-box__avatar {
    flex: none;
  }

  .author-box__avatar img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-box__name {
    font-family: var(--font-display);
    font-size: var(--text-1);
  }

  .author-box__bio {
    margin-block-start: var(--space-2);
    font-size: var(--text--1);
    color: var(--ink-soft);
  }

  /* --- FAQ-Affiliate-Fussnote ------------------------------------ */
  .faq-note {
    display: block;
    margin-block-start: var(--space-2);
    font-size: var(--text--1);
    color: var(--ink-soft);
  }
</style>
