      <img src="/assets/images/author.jpg" alt="" onerror="this.style.display='none'" />
    </div>
    <div>
      <p class="author-box__name">Christian Schippel</p>
      <p class="author-box__bio">
        Trained chef, 37, lived in Byron Bay from 2016 to 2018. Moving back to the Northern Rivers in summer 2026 with Lucy and two kids. Writes here about visas, costs and everything that happens along the way.
        <a href="/en/about">More about us</a>
      </p>
    </div>
  </div>

  <!-- Related articles: gleiche 3 Ziele + Texte wie live -->
  <WeiterlesenPfade
    lang="en"
    eyebrow="Keep reading"
    ueberschrift="You might also like"
    artikel={weiterlesen}
  />

  <!-- Newsletter section, Texte 1:1 wie live (Handler zentral im BaseLayout) -->
  <section class="section" id="newsletter" aria-labelledby="newsletter-h">
    <div class="container container--text">
      <div class="card texture-paper newsletter-karte">
        <p class="eyebrow">Did this help?</p>
        <h2 id="newsletter-h">We will send you updates</h2>
        <p>New articles, real experiences, concrete numbers, straight to your inbox.</p>
        <form class="newsletter-form" data-newsletter>
          <input type="email" placeholder="Your email address" required aria-label="Your email address" />
          <button type="submit">Subscribe</button>
        </form>
        <p class="newsletter-hinweis">You can unsubscribe at any time.</p>
