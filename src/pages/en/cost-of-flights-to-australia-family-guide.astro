      <span class="update-log__datum">16 June 2026</span>
      <span class="update-log__text">Added Booking.com as an affiliate link (advertising) in the booking section.</span>
    </div>
    <div class="update-log__eintrag">
      <span class="update-log__datum">1 June 2026</span>
      <span class="update-log__text">Article published (English version of the German original from May 2026).</span>
    </div>
  </div>

  <!-- Author Box -->
  <div class="author-box">
    <div class="author-box__avatar">
      <img src="/assets/images/author.jpg" alt="" onerror="this.style.display='none'" />
    </div>
    <div>
      <p class="author-box__name">Christian Schippel</p>
      <p class="author-box__bio">
        Trained chef, 37, lived in Byron Bay from 2016 to 2018. Moving back to the Northern Rivers in summer 2026 with Lucy and two kids. Writes here about visas, costs and everything that happens along the way.
        <a href="/en/about">More about us</a>
      </p>
    </div>
  </div>

  <!-- Related articles: gleiche 3 Ziele + Texte wie live -->
  <WeiterlesenPfade
    lang="en"
    eyebrow="Keep reading"
    ueberschrift="You might also like"
    artikel={weiterlesen}
  />

  <!-- Newsletter section, Texte 1:1 wie live -->
  <section class="section" id="newsletter" aria-labelledby="newsletter-h">
    <div class="container container--text">
      <div class="card texture-paper newsletter-karte">
        <p class="eyebrow">Did this help?</p>
        <h2 id="newsletter-h">We will send you updates</h2>
        <p>New articles, real experiences, concrete numbers, straight to your inbox.</p>
        <form class="newsletter-form" data-newsletter>
          <input type="email" placeholder="Your email address" required aria-label="Your email address" />
          <button type="submit">Subscribe</button>
        </form>
        <p class="newsletter-hinweis">You can unsubscribe at any time.</p>
      </div>
    </div>
  </section>
</ArtikelLayout>

<style>
  .newsletter-karte {
    display: grid;
    gap: var(--space-3);
    rotate: -0.5deg;
  }

  .newsletter-form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-2);
  }

  .newsletter-form input {
    flex: 1;
    min-width: 220px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-body);
    color: var(--ink);
  }

  .newsletter-form button {
    background: var(--accent);
    color: var(--accent-contrast);
    border: none;
    border-radius: var(--radius-s);
    padding: var(--space-3) var(--space-5);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
  }

  .newsletter-form button:hover {
    background: var(--accent-strong);
  }

  .newsletter-hinweis {
    font-family: var(--font-mono);
    font-size: var(--text--1);
    color: var(--ink-soft);
  }
</style>

<style>
  .artikel-bild {
    width: 100%;
    border-radius: var(--radius-m);
  }

  /* --- Inhaltsverzeichnis ---------------------------------------
     StickyToc erwartet ab 1100px eine Spalte vom Parent-Layout.
     Im Ein-Spalten-Artikel: bis 1439px als Aufklappbox im Fluss,
     ab 1440px als sticky Randspalte links neben der Lese-Spalte. */
  :global(.prose) {
    position: relative;
  }

  @media (min-width: 1100px) and (max-width: 1439.98px) {
    .toc-halter :global(.toc) {
      position: static;
    }

    .toc-halter :global(.toc__box--desktop) {
      display: none;
    }

    .toc-halter :global(.toc__box--mobile) {
      display: block;
    }
  }

  @media (min-width: 1440px) {
    .toc-halter {
      position: absolute;
      inset-block: 0;
      inset-inline-start: calc(-240px - var(--space-7));
      width: 240px;
      margin: 0;
    }
  }

  /* --- Info-Boxen (Key takeaways, Werbe-Hinweis) ----------------- */
  .info-box {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-card);
    padding: var(--space-5);
  }

  .info-box__titel {
    font-family: var(--font-mono);
    font-size: var(--text--1);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-soft);
    margin-block-end: var(--space-3);
  }

  .info-box p + p,
  .info-box ul {
    margin-block-start: var(--space-3);
  }

  .info-box ul {
    padding-inline-start: 1.4em;
  }

  .info-box li + li {
    margin-block-start: var(--space-2);
  }

  /* --- Charts ---------------------------------------------------- */
  /* Charts als "gedrucktes Papier": bewusst IMMER hell (feste Hexwerte statt
     Tokens), damit die hell-fixierten SVG-Farben auch im Dark Mode lesbar
     bleiben. Passt zum Retro-Look: ein eingeklebtes Chart im Reisetagebuch. */
  .chart-figur {
    margin-block: var(--space-6);
    background: #fbf7ee;
    border: 1px solid #ddd3bc;
    border-radius: var(--radius-m);
    padding: var(--space-4);
    overflow-x: auto;
    box-shadow: var(--shadow-card);
  }

  .chart-figur svg {
    margin-inline: auto;
  }

  /* --- Kosten-Tabelle (frei im Lesefluss) ------------------------ */
  .kosten-tabelle {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text--1);
    margin-block: var(--space-5);
  }

  .kosten-tabelle th {
    text-align: left;
    font-family: var(--font-mono);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
    padding: var(--space-2);
    border-bottom: 1px solid var(--line);
  }

  .kosten-tabelle td {
    padding: var(--space-2);
    border-bottom: 1px dashed var(--line);
    vertical-align: top;
  }

  .kosten-tabelle tbody tr:last-child td {
    border-bottom: none;
  }

  /* --- Trust Box ------------------------------------------------- */
  .trust-box {
    background: var(--surface);
    border: 1px dashed var(--line);
    border-radius: var(--radius-s);
    padding: var(--space-5);
    font-size: var(--text--1);
    color: var(--ink-soft);
  }

  .trust-box p + p {
    margin-block-start: var(--space-3);
  }

  /* --- Update-Log ------------------------------------------------ */
  .update-log {
    font-family: var(--font-mono);
    font-size: var(--text--1);
  }

  .update-log__titel {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-soft);
    margin-block-end: var(--space-2);
  }

  .update-log__eintrag {
    display: flex;
    gap: var(--space-4);
    padding-block: var(--space-2);
    border-top: 1px dashed var(--line);
  }

  .update-log__datum {
    flex: none;
    color: var(--ink-soft);
  }

  /* --- Autor-Box ------------------------------------------------- */
  .author-box {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-card);
    padding: var(--space-5);
  }

  .author-box__avatar {
    flex: none;
  }

  .author-box__avatar img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-box__name {
    font-family: var(--font-display);
    font-size: var(--text-1);
  }

  .author-box__bio {
    margin-block-start: var(--space-2);
    font-size: var(--text--1);
    color: var(--ink-soft);
  }
</style>
